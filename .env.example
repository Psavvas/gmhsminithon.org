# Member Authentication Configuration

# Google Sheet CSV URL for approved member Shoo IDs
# Format: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/export?format=csv&gid={SHEET_ID}
# Get the sheet ID (gid) from the URL when viewing the specific sheet tab
MEMBER_APPROVED_SHOO_SUBS_GOOGLE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/export?format=csv&gid=YOUR_SHEET_ID"

# Secret key for signing member session cookies (generate with: openssl rand -hex 32)
MEMBER_SESSION_SECRET="your-random-secret-key-here"

# Enable debug logging for member authentication (set to "true" for development)
MEMBER_AUTH_DEBUG="false"

# Production site URL (used for JWT audience verification)
PUBLIC_SITE_URL="https://gmhsminithon.org"

# Optional: Custom Shoo authentication base URL (defaults to https://shoo.dev)
# PUBLIC_SHOO_BASE_URL="https://shoo.dev"

# Optional: Comma-separated list of approved Shoo user IDs (pairwise_sub values)
# Use this as a fallback or in addition to the Google Sheet
# MEMBER_APPROVED_SHOO_SUBS="user-id-1,user-id-2,user-id-3"

# Email Octopus API Configuration (for newsletter subscriptions)
EMAIL_OCTOPUS_API_KEY="your-email-octopus-api-key"
EMAIL_OCTOPUS_LIST_ID="your-email-octopus-list-id"

# Vercel Analytics (automatically set by Vercel in production)
# PUBLIC_VERCEL_ANALYTICS_ID="your-analytics-id"
