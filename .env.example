# Member Authentication Configuration

# Google Sheet CSV URL for approved member Shoo IDs
# Format: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/export?format=csv&gid={SHEET_ID}
# Get the sheet ID (gid) from the URL when viewing the specific sheet tab
MEMBER_APPROVED_SHOO_SUBS_GOOGLE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/export?format=csv&gid=YOUR_SHEET_ID"

# Secret key for signing member session cookies (generate with: openssl rand -hex 32)
MEMBER_SESSION_SECRET="your-random-secret-key-here"

# Enable debug logging for member authentication (set to "true" for development)
MEMBER_AUTH_DEBUG="false"

# Canonical site URL. Shoo tokens are bound to the address they were issued on,
# and this tells the server to accept tokens issued for this address no matter
# which deployment URL the request arrives on. Set it to your real domain.
# Note it does not make Shoo user IDs stable across addresses — sign in on one
# stable address (see the README) and approve the ID from that address.
PUBLIC_SITE_URL="https://gmhsminithon.org"

# Optional: Custom Shoo authentication base URL (defaults to https://shoo.dev)
# PUBLIC_SHOO_BASE_URL="https://shoo.dev"

# Optional: Comma-separated list of approved Shoo user IDs (pairwise_sub values)
# Use this as a fallback or in addition to the Google Sheet
# MEMBER_APPROVED_SHOO_SUBS="user-id-1,user-id-2,user-id-3"

# Admin Portal (/admin) Configuration
#
# When copying these into Vercel, paste the bare value without the quotes shown
# here — quotes belong to the .env file format, not to the value itself.

# Shoo user IDs that always have admin access. This is the bootstrap list: IDs
# here cannot be removed from inside the portal, so you can never lock yourself
# out. Comma- or space-separated. Admins can use the member portal as well.
ADMIN_APPROVED_SHOO_SUBS="your-shoo-user-id"

# Secret key for signing admin session cookies (generate with: openssl rand -hex 32)
# Falls back to MEMBER_SESSION_SECRET if unset, but a separate value is better.
ADMIN_SESSION_SECRET="another-random-secret-key-here"

# Enable debug logging for admin sign-in (set to "true" for development)
ADMIN_AUTH_DEBUG="false"

# Neon Postgres connection string. Without it the site serves the JSON files in
# src/data and the admin portal is read-only. With it, content edited in the
# portal is saved to the database and appears on the site within ~30 seconds.
# Vercel's Neon integration sets this for you; POSTGRES_URL and
# NEON_DATABASE_URL are also accepted.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# UploadThing token for image uploads from the admin portal (UploadThing
# dashboard -> API Keys -> V7 token). Without it you can still paste image URLs.
UPLOADTHING_TOKEN="your-uploadthing-token"

# Email Octopus API Configuration (for newsletter subscriptions)
EMAIL_OCTOPUS_API_KEY="your-email-octopus-api-key"
EMAIL_OCTOPUS_LIST_ID="your-email-octopus-list-id"

# Vercel Analytics (automatically set by Vercel in production)
# PUBLIC_VERCEL_ANALYTICS_ID="your-analytics-id"
