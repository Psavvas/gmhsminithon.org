---
import PublicLayout from '../layouts/PublicLayout.astro';
import fundraisingData from '../data/fundraising.json';
import clubInfo from '../data/clubInfo.json';
import eventsData from '../data/events.json';
import { eventToSlug } from '../utils/events';

export const prerender = true;

const currentTotal = fundraisingData.currentTotal.toLocaleString('en-US', {
	style: 'currency',
	currency: 'USD',
	minimumFractionDigits: 0,
	maximumFractionDigits: 0
});

const today = new Date();
const upcomingEvents = eventsData
	.filter((event) => new Date(event.date) >= today)
	.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
	.slice(0, 3);

const formatDate = (dateString: string) =>
	new Date(dateString).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

const aboutParagraphs = clubInfo.about.split('\n\n').filter(Boolean);
---

<PublicLayout title="GMHS Mini-THON">
	<section class="hero">
		<div class="hero-content">
			<p class="eyebrow">Great Mills High School</p>
			<h1>Mini-THON</h1>
			<p class="lead">{clubInfo.mission}</p>
			<div class="hero-actions">
				<a href={fundraisingData.donorDriveLink} class="button primary" target="_blank" rel="noopener noreferrer">Donate now</a>
				<a href="/get-involved" class="button ghost">Get involved</a>
			</div>
		</div>
	</section>

	<div class="page-content">
		<section class="split">
			<div class="split-card">
				<h2>About us</h2>
				{aboutParagraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				<a href="/about" class="text-link">Read our story</a>
			</div>
			<div class="split-card photo-card">
				<img src="/sidePicture.jpeg" alt="Mini-THON volunteers supporting pediatric cancer families" loading="lazy" />
			</div>
		</section>

		<section class="grid-section">
			<div class="grid-card">
				<h2>Upcoming events</h2>
				<ul class="event-list">
					{upcomingEvents.length > 0 ? (
						upcomingEvents.map((event) => (
							<li>
								<a class="event-link" href={`/events/${eventToSlug(event.title)}`}>
									<span class="event-date">{formatDate(event.date)}</span>
									<div>
										<p class="event-title">{event.title}</p>
										<p class="event-desc">{event.public_description}</p>
									</div>
								</a>
							</li>
						))
					) : (
						<li class="event-empty">New events coming soon.</li>
					)}
				</ul>
				<a href="/events" class="text-link">View all events</a>
			</div>
			<div class="grid-card highlight">
				<h2>Fundraising at a glance</h2>
				<p class="big-figure">{currentTotal}</p>
				<p class="muted">Raised in {fundraisingData.currentYear} to support families.</p>
				<a href="/fundraising" class="button primary">Support the cause</a>
			</div>
		</section>

		<section class="link-section">
			<h2>Get involved</h2>
			<div class="links-grid">
				<a href={fundraisingData.donorDriveLink} class="link-card" target="_blank" rel="noopener noreferrer">
					<h3>Donate now</h3>
					<p>Contribute directly through DonorDrive and make an impact. Quick, easy and secure.</p>
				</a>
				<a href="/get-involved" class="link-card">
					<h3>Join the club</h3>
					<p>Students join our club meeting {clubInfo.meetings.general}</p>
				</a>
				<a href={clubInfo.socialMedia.instagram} class="link-card" target="_blank" rel="noopener noreferrer">
					<h3>Follow us</h3>
					<p>Get the latest stories, highlights, and event updates. Follow us @instagramHandle</p>
				</a>
				<a href="/sponsors" class="link-card">
					<h3>Sponsor Us</h3>
					<p>Have your business sponsor Mini-THON to support our mission.</p>
				</a>

			</div>
		</section>
	</div>
</PublicLayout>

<style>
	.hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2.5rem;
		padding: clamp(4rem, 10vh, 6rem) 3.5rem clamp(2.5rem, 8vh, 4.5rem);
		border-radius: 0;
		color: var(--white);
		box-shadow: var(--shadow-soft);
		margin-top: 0;
		margin-bottom: 3.5rem;
		animation: fade-rise 0.8s ease both;
		background-image:
			linear-gradient(120deg, rgba(12, 20, 35, 0.85), rgba(44, 70, 114, 0.65)),
			url('/banner.jpeg');
		background-size: cover;
		background-position: center;
		overflow: hidden;
		width: 100%;
		min-height: 100svh;
		align-items: end;
		box-sizing: border-box;
	}

	.hero-content {
		max-width: 620px;
		padding-bottom: 1rem;
		align-self: end;
	}

	.hero-content h1 {
		font-size: clamp(2.8rem, 3vw, 4.2rem);
		margin-bottom: 1rem;
		color: var(--white);
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.3em;
		font-size: 0.75rem;
		font-weight: 600;
		opacity: 0.8;
		margin-bottom: 1rem;
	}

	.lead {
		font-size: 1.2rem;
		line-height: 1.8;
		max-width: 540px;
		margin-bottom: 2rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}


	section {
		margin-bottom: 3.5rem;
	}

	.split {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
		gap: 1.5rem;
		align-items: stretch;
		animation: fade-rise 0.8s ease both;
		animation-delay: 0.1s;
	}

	.split-card {
		background: transparent;
		border-radius: 20px;
		padding: 2rem;
		box-shadow: none;
		border: none;
		min-width: 0;
	}


	.split-card p {
		line-height: 1.8;
		color: var(--ink-700);
	}

	.photo-card {
		padding: 0;
		overflow: hidden;
		display: flex;
		border-radius: 20px;
		aspect-ratio: 4 / 3;
		min-height: 260px;
		width: 100%;
		max-width: 100%;
	}

	.photo-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		max-width: 100%;
		flex-shrink: 0;
	}

	.grid-section {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
		animation: fade-rise 0.8s ease both;
		animation-delay: 0.2s;
	}

	.grid-card {
		background: var(--surface-raised);
		border-radius: 20px;
		padding: 2rem;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
	}

	.grid-card.highlight {
		background: linear-gradient(160deg, rgba(44, 70, 114, 0.95), rgba(44, 70, 114, 0.8));
		color: var(--white);
		border: none;
	}

	.grid-card.highlight h2,
	.grid-card.highlight .muted {
		color: var(--white);
	}

	.event-list {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 1.5rem;
		display: grid;
		gap: 1.2rem;
	}

	.event-list li {
		list-style: none;
	}

	.event-link {
		display: grid;
		grid-template-columns: 70px 1fr;
		gap: 1rem;
		align-items: start;
		text-decoration: none;
		color: inherit;
		width: 100%;
		box-sizing: border-box;
		border-radius: 16px;
		padding: 0.35rem 0.4rem;
	}

	.event-link * {
		text-decoration: none;
		color: inherit;
	}


	.event-date {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--brand-ink);
		background: rgba(106, 170, 228, 0.15);
		padding: 0.5rem 0.7rem;
		border-radius: 12px;
		text-align: center;
	}

	.event-title {
		font-weight: 600;
		margin: 0 0 0.35rem;
		color: var(--ink-900);
	}

	.event-desc {
		margin: 0;
		color: var(--ink-700);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.event-empty {
		color: var(--ink-500);
	}

	.big-figure {
		font-size: 2.6rem;
		font-weight: 600;
		margin: 1rem 0 0.5rem;
	}

	.muted {
		color: var(--ink-500);
		margin-bottom: 2rem;
	}

	.link-section h2 {
		margin-bottom: 1.5rem;
	}

	.link-section {
		animation: fade-rise 0.8s ease both;
		animation-delay: 0.3s;
	}

	.links-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	.link-card {
		background: var(--surface-raised);
		padding: 1.75rem;
		border-radius: 18px;
		text-decoration: none;
		color: inherit;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.link-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 20px 40px rgba(28, 42, 58, 0.12);
	}

	.link-card h3 {
		margin-bottom: 0.5rem;
	}

	.link-card p {
		color: var(--ink-700);
		margin: 0;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.9rem 1.8rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		letter-spacing: 0.02em;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		border: 1px solid transparent;
	}

	.button.primary {
		background: var(--brand-sky);
		color: var(--brand-ink);
		box-shadow: 0 14px 25px rgba(106, 170, 228, 0.3);
	}

	.button.ghost {
		background: transparent;
		color: var(--white);
		border-color: rgba(255, 255, 255, 0.5);
	}

	.grid-card.highlight .button.primary {
		background: var(--white);
		color: var(--brand-ink);
	}

	.button:hover {
		transform: translateY(-2px);
		box-shadow: 0 18px 35px rgba(28, 42, 58, 0.18);
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: var(--brand-ink);
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.text-link::after {
		content: '->';
		transition: transform 0.2s ease;
	}

	.text-link:hover::after {
		transform: translateX(3px);
	}

	.page-content {
		max-width: 1160px;
		margin: 0 auto;
		padding: 3rem 1.5rem 4rem;
		overflow-x: hidden;
		width: 100%;
	}

	@keyframes fade-rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	:global(main) {
		width: 100% !important;
		max-width: none !important;
		padding: 0 !important;
		margin: 0 !important;
	}

	@media (max-width: 768px) {
		.hero {
			padding: 2.5rem 2rem;
			min-height: auto;
			background-image:
				linear-gradient(120deg, rgba(12, 20, 35, 0.92), rgba(44, 70, 114, 0.88)),
				url('/banner.jpeg');
			background-position: center center;
			background-size: cover;
		}

		.hero-content {
			padding-bottom: 2rem;
		}

		.hero-actions {
			flex-direction: column;
			align-items: flex-start;
		}

		.split {
			grid-template-columns: 1fr;
		}

		.split-card {
			padding: 1.5rem;
		}

		.event-link {
			grid-template-columns: 1fr;
		}

		.event-date {
			text-align: left;
			width: fit-content;
		}
	}
</style>
