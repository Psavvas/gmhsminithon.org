---
import PublicLayout from '../../layouts/PublicLayout.astro';
import EventCountdown from '../../components/EventCountdown.astro';
import MDXContent from '../../components/MDXContent.astro';
import { getAllEvents, formatDate, eventToSlug } from '../../utils/events';

export const prerender = true;

export async function getStaticPaths() {
  const events = getAllEvents();
  return events.map(event => ({
    params: { slug: eventToSlug(event.title) },
    props: { event },
  }));
}

const { event } = Astro.props;

// Format the date for display
const formattedDate = formatDate(event.date);
const fullDate = new Date(event.date).toLocaleDateString('en-US', { 
	weekday: 'long',
	year: 'numeric',
	month: 'long',
	day: 'numeric'
});
---

<PublicLayout title={`${event.title} - Mini-THON`}>
	<article class="event-detail">
		<div class="event-hero">
			<div class="event-hero-content">
				<div class="event-meta">
					<span class={`event-type ${event.event_type}`}>{event.event_type}</span>
				</div>
				<h1>{event.title}</h1>
				<div class="event-info-row">
					<div class="event-info-item">
						<span class="info-icon">📅</span>
						<div class="info-content">
							<span class="info-label">Date</span>
							<time datetime={event.date}>{fullDate}</time>
						</div>
					</div>
					{event.location && (
						<div class="event-info-item">
							<span class="info-icon">📍</span>
							<div class="info-content">
								<span class="info-label">Location</span>
								<span>{event.location}</span>
							</div>
						</div>
					)}
				</div>
			</div>
			<div class="event-countdown-wrapper">
				<EventCountdown eventDate={event.date} />
			</div>
		</div>

		<section class="event-content">
			<div class="description-card">
				<h2>About This Event</h2>
				<MDXContent content={event.public_description} />
			</div>
			
			{event.media.links && event.media.links.length > 0 && (
				<div class="event-links-card">
					<h3>Related Links</h3>
					<ul>
						{event.media.links.map(link => (
							<li>
								<a href={link} target="_blank" rel="noopener noreferrer">{link}</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</section>

		<footer class="event-footer">
			<a href="/events" class="back-link">← Back to Events</a>
		</footer>
	</article>
</PublicLayout>

<style>
	.event-detail {
		max-width: 1000px;
		margin: 0 auto;
	}

	.event-hero {
		background: var(--surface-raised);
		padding: 2.5rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		margin-bottom: 2rem;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: start;
		animation: fade-rise 0.6s ease both;
	}

	.event-hero-content {
		flex: 1;
	}

	.event-meta {
		margin-bottom: 1rem;
	}

	.event-type {
		display: inline-block;
		padding: 0.35rem 0.9rem;
		border-radius: 12px;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.event-type.gaming {
		background: #E3F2FD;
		color: #1976D2;
	}

	.event-type.dine-to-donate {
		background: #FFF3E0;
		color: #F57C00;
	}

	.event-type.fundraiser {
		background: #F3E5F5;
		color: #7B1FA2;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		color: var(--ink-900);
		margin: 0 0 1.5rem 0;
		line-height: 1.2;
	}

	.event-info-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.event-info-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.info-icon {
		font-size: 1.5rem;
		line-height: 1;
	}

	.info-content {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.info-label {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-500);
	}

	.info-content time,
	.info-content span {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--ink-900);
	}

	.event-countdown-wrapper {
		min-width: 280px;
	}

	.event-content {
		display: grid;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.description-card {
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		animation: fade-rise 0.8s ease both;
		animation-delay: 0.1s;
	}

	.description-card h2 {
		font-size: 1.5rem;
		color: var(--ink-900);
		margin-bottom: 1.25rem;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--brand-sky);
	}

	.event-links-card {
		background: linear-gradient(135deg, rgba(106, 170, 228, 0.08), rgba(106, 170, 228, 0.03));
		padding: 1.5rem;
		border-radius: 16px;
		border: 1px solid var(--border-soft);
		animation: fade-rise 0.8s ease both;
		animation-delay: 0.2s;
	}

	.event-links-card h3 {
		font-size: 1.2rem;
		color: var(--brand-ink);
		margin-bottom: 1rem;
	}

	.event-links-card ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}

	.event-links-card li {
		margin: 0;
	}

	.event-links-card a {
		color: var(--brand-ink);
		text-decoration: none;
		word-break: break-all;
		transition: color 0.2s ease;
		display: inline-block;
		padding: 0.25rem 0;
	}

	.event-links-card a:hover {
		color: var(--brand-sky);
		text-decoration: underline;
	}

	.event-footer {
		padding-top: 2rem;
		border-top: 2px solid var(--border-soft);
		animation: fade-rise 0.8s ease both;
		animation-delay: 0.3s;
	}

	.back-link {
		color: var(--brand-ink);
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		transition: all 0.3s;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.back-link:hover {
		color: var(--brand-sky);
		transform: translateX(-4px);
	}

	@keyframes fade-rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		.event-hero {
			grid-template-columns: 1fr;
			padding: 1.5rem;
			gap: 1.5rem;
		}

		.event-countdown-wrapper {
			min-width: auto;
		}

		h1 {
			font-size: 1.75rem;
		}

		.event-info-row {
			flex-direction: column;
			gap: 1rem;
		}

		.description-card {
			padding: 1.5rem;
		}
	}
</style>
