---
import PublicLayout from "../../layouts/PublicLayout.astro";
import MemberLogin from "../../components/member-auth/MemberLogin";
import {
  MEMBER_AUTH_CALLBACK_PATH,
  MEMBER_HOME_PATH,
  MEMBER_LOGIN_PATH,
  checkMemberAuth,
  getShooBaseUrl,
  hasMemberApprovalSourceConfigured,
} from "../../utils/auth";

// Check if already logged in
if (await checkMemberAuth(Astro.request)) {
  return Astro.redirect("/members");
}

const authConfigured = hasMemberApprovalSourceConfigured();
---

<PublicLayout title="Member Login - Mini-THON">
  <div class="login-container">
    <h1>Member Portal</h1>
    <p class="subtitle">Sign in with Shoo to access member-only updates</p>
    <p class="info-note">
      Access is limited to approved GMHS Mini-THON members. After you sign in,
      we verify your Shoo account before granting access to the portal.
    </p>
    <p class="info-note">
      If your account has not been added yet, you will see the exact Shoo user
      ID to send to an admin for approval.
    </p>

    <MemberLogin
      client:load
      shooBaseUrl={getShooBaseUrl()}
      callbackPath={MEMBER_AUTH_CALLBACK_PATH}
      loginPath={MEMBER_LOGIN_PATH}
      membersPath={MEMBER_HOME_PATH}
      sessionEndpoint="/api/member-auth/session"
      showConfigurationNotice={!authConfigured}
    />
  </div>
</PublicLayout>

<style>
  .login-container {
    --mono-font:
      "SFMono-Regular", ui-monospace, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
    box-sizing: border-box;
    width: min(100%, 520px);
    margin: 0 auto;
    background: var(--surface-raised);
    padding: 3rem 2rem;
    border-radius: 20px;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--border-soft);
  }

  h1 {
    font-size: 2rem;
    color: var(--ink-900);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .subtitle {
    text-align: center;
    color: var(--brand-ink);
    margin-bottom: 0.5rem;
    font-weight: 600;
    font-size: 1.05rem;
  }

  .info-note {
    text-align: center;
    color: var(--ink-500);
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  :global(.member-login-panel) {
    display: grid;
    gap: 1rem;
  }

  :global(.configuration-message) {
    background: rgba(44, 70, 114, 0.08);
    border: 1px solid rgba(44, 70, 114, 0.16);
    color: var(--ink-700);
    padding: 1rem;
    border-radius: 12px;
    line-height: 1.6;
  }

  :global(.error-message) {
    background: #ffebee;
    color: #c62828;
    padding: 1rem;
    border-radius: 12px;
    line-height: 1.6;
  }

  :global(.member-auth-error) {
    display: grid;
    gap: 0.9rem;
  }

  :global(.member-auth-error__message) {
    margin: 0;
  }

  :global(.member-auth-error__user-id-block) {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.2rem;
  }

  :global(.member-auth-error__user-id-label) {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  :global(.member-auth-error__user-id-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  :global(.member-auth-error__user-id) {
    display: inline-block;
    padding: 0.65rem 0.8rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(198, 40, 40, 0.18);
    color: #7f1d1d;
    word-break: break-all;
  }

  :global(.member-auth-copy-button) {
    border: 1px solid rgba(198, 40, 40, 0.22);
    background: white;
    color: #8b1e1e;
    border-radius: 999px;
    padding: 0.65rem 0.95rem;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
  }

  :global(.member-auth-copy-button:hover) {
    background: rgba(255, 255, 255, 0.88);
  }

  :global(.member-auth-copy-status) {
    margin: 0;
    font-size: 0.9rem;
    color: #8b1e1e;
  }

  code {
    font-family: var(--mono-font);
    font-size: 0.95em;
  }

  :global(.submit-button) {
    width: 100%;
    background: linear-gradient(
      135deg,
      rgba(44, 70, 114, 0.95),
      rgba(44, 70, 114, 0.8)
    );
    color: white;
    padding: 1rem;
    border: none;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.submit-button:hover) {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(28, 42, 58, 0.2);
  }

  :global(.submit-button:disabled) {
    cursor: wait;
    opacity: 0.7;
    transform: none;
    box-shadow: none;
  }

  :global(.login-helper) {
    color: var(--ink-700);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .login-container {
      padding: 2rem 1.5rem;
    }

    h1 {
      font-size: 1.75rem;
    }

    .info-note {
      margin-bottom: 1.5rem;
    }

    :global(.member-auth-error__user-id-row) {
      flex-direction: column;
      align-items: stretch;
    }

    :global(.member-auth-copy-button) {
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .login-container {
      padding: 1.5rem 1rem;
      border-radius: 16px;
    }

    .subtitle {
      font-size: 1rem;
    }
  }
</style>
