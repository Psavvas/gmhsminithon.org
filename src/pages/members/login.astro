---
import PublicLayout from "../../layouts/PublicLayout.astro";
import MemberLogin from "../../components/member-auth/MemberLogin";
import {
  MEMBER_AUTH_CALLBACK_PATH,
  MEMBER_HOME_PATH,
  checkMemberAuth,
  getShooBaseUrl,
  hasApprovedMemberSubjects,
} from "../../utils/auth";

// Check if already logged in
if (await checkMemberAuth(Astro.request)) {
  return Astro.redirect("/members");
}

const authConfigured = hasApprovedMemberSubjects();
---

<PublicLayout title="Member Login - Mini-THON">
  <div class="login-container">
    <h1>Member Portal Login</h1>
    <p class="subtitle">For GMHS Mini-THON members only</p>
    <p class="info-note">
      Sign in with Shoo, then we will confirm that your Shoo approval ID is on
      the private approved-user list before granting access. If this deployment
      is not configured yet, you will see that after sign-in.
    </p>

    {
      !authConfigured && (
        <div class="error-message">
          This deployment is missing the
          <code>MEMBER_APPROVED_SHOO_SUBS</code> environment variable, so
          access cannot be granted yet. You can still sign in below to confirm
          your Shoo approval ID and authorization status.
        </div>
      )
    }

    <MemberLogin
      client:load
      shooBaseUrl={getShooBaseUrl()}
      callbackPath={MEMBER_AUTH_CALLBACK_PATH}
      membersPath={MEMBER_HOME_PATH}
      sessionEndpoint="/api/member-auth/session"
    />
  </div>
</PublicLayout>

<style>
  .login-container {
    --mono-font:
      "SFMono-Regular", ui-monospace, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
    max-width: 520px;
    margin: 0 auto;
    background: var(--surface-raised);
    padding: 3rem 2rem;
    border-radius: 20px;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--border-soft);
  }

  h1 {
    font-size: 2rem;
    color: var(--ink-900);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .subtitle {
    text-align: center;
    color: var(--brand-ink);
    margin-bottom: 0.5rem;
    font-weight: 600;
    font-size: 1.05rem;
  }

  .info-note {
    text-align: center;
    color: var(--ink-500);
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  :global(.member-login-panel) {
    display: grid;
    gap: 1rem;
  }

  :global(.error-message) {
    background: #ffebee;
    color: #c62828;
    padding: 1rem;
    border-radius: 12px;
    line-height: 1.6;
  }

  code {
    font-family: var(--mono-font);
    font-size: 0.95em;
  }

  :global(.submit-button) {
    width: 100%;
    background: linear-gradient(
      135deg,
      rgba(44, 70, 114, 0.95),
      rgba(44, 70, 114, 0.8)
    );
    color: white;
    padding: 1rem;
    border: none;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.submit-button:hover) {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(28, 42, 58, 0.2);
  }

  :global(.submit-button:disabled) {
    cursor: wait;
    opacity: 0.7;
    transform: none;
    box-shadow: none;
  }

  :global(.login-helper) {
    color: var(--ink-700);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .login-container {
      padding: 2rem 1.5rem;
    }
  }
</style>
