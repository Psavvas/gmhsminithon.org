---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { checkMemberAuth } from '../../utils/auth';
import clubInfo from '../../data/clubInfo.json';

// Check authentication
if (!checkMemberAuth(Astro.request)) {
  return Astro.redirect('/members/login');
}
---

<MemberLayout title="Meeting Info - Mini-THON">
	<h1>Meeting Information</h1>
	
	<section class="meeting-schedule">
		<h2>📅 Meeting Schedule</h2>
		<div class="meeting-card">
			<h3>General Meetings</h3>
			<p class="time">{clubInfo.meetings.general}</p>
			<p class="description">All members are welcome! We discuss upcoming events, fundraising updates, and club business.</p>
		</div>
		<div class="meeting-card board">
			<h3>Board Meetings</h3>
			<p class="time">{clubInfo.meetings.board}</p>
			<p class="description">For board members and committee chairs. Leadership team discusses strategic planning and event logistics.</p>
		</div>
	</section>

	<section class="communication">
		<h2>💬 Stay Connected</h2>
		
		<div class="comm-card instagram">
			<div class="icon">📸</div>
			<div class="content">
				<h3>Instagram</h3>
				<p>Follow us for updates, event photos, and announcements</p>
				<a href={clubInfo.socialMedia.instagram} target="_blank" rel="noopener noreferrer" class="link-button">
					Follow @ourminithon
				</a>
			</div>
		</div>

		<div class="comm-card groupme">
			<div class="icon">💬</div>
			<div class="content">
				<h3>GroupMe</h3>
				<p>{clubInfo.socialMedia.groupme}</p>
				<div class="join-code">
					<strong>Join Code:</strong> <code>{clubInfo.socialMedia.groupmeCode}</code>
				</div>
				<p class="note">Use this code to join our GroupMe group for real-time updates and discussions.</p>
			</div>
		</div>
	</section>

	<section class="contacts">
		<h2>📞 Contact Information</h2>
		<div class="contact-grid">
			<div class="contact-card">
				<h3>General Inquiries</h3>
				<p><strong>Email:</strong> <a href={`mailto:${clubInfo.contact.email}`}>{clubInfo.contact.email}</a></p>
				<p><strong>Phone:</strong> {clubInfo.contact.phone}</p>
			</div>
			{clubInfo.officers.slice(0, 3).map(officer => (
				<div class="contact-card">
					<h3>{officer.role}</h3>
					<p class="name">{officer.name}</p>
					<p><a href={`mailto:${officer.email}`}>{officer.email}</a></p>
				</div>
			))}
		</div>
	</section>

	<section class="resources">
		<h2>📚 Member Resources</h2>
		<div class="resource-list">
			<div class="resource-item">
				<h3>Event Planning Guidelines</h3>
				<p>Contact the Events Coordinator for access to our event planning templates and checklists.</p>
			</div>
			<div class="resource-item">
				<h3>Fundraising Materials</h3>
				<p>Marketing materials, flyers, and social media graphics are available from the board members.</p>
			</div>
			<div class="resource-item">
				<h3>Four Diamonds Information</h3>
				<p>Learn more about our cause and get talking points for promoting our events.</p>
			</div>
		</div>
	</section>
</MemberLayout>

<style>
	h1 {
		font-size: 2.5rem;
		color: #041E42;
		margin-bottom: 2rem;
	}

	section {
		background: white;
		padding: 2rem;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0,0,0,0.1);
		margin-bottom: 2rem;
	}

	h2 {
		font-size: 1.8rem;
		color: #041E42;
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 3px solid #6A4C93;
	}

	.meeting-card {
		background: #F8F9FA;
		padding: 1.5rem;
		border-radius: 8px;
		margin-bottom: 1rem;
		border-left: 4px solid #6A4C93;
	}

	.meeting-card.board {
		border-left-color: #FDB927;
		background: #FFF9E6;
	}

	.meeting-card h3 {
		color: #041E42;
		font-size: 1.3rem;
		margin-bottom: 0.5rem;
	}

	.meeting-card .time {
		font-size: 1.1rem;
		font-weight: 600;
		color: #6A4C93;
		margin-bottom: 0.75rem;
	}

	.meeting-card .description {
		color: #333;
		line-height: 1.6;
		margin: 0;
	}

	.comm-card {
		display: flex;
		gap: 1.5rem;
		background: #F8F9FA;
		padding: 2rem;
		border-radius: 8px;
		margin-bottom: 1.5rem;
		align-items: flex-start;
	}

	.comm-card.instagram {
		background: linear-gradient(135deg, #FFF5F8 0%, #FFF 100%);
		border: 2px solid #E292AA;
	}

	.comm-card.groupme {
		background: linear-gradient(135deg, #F0F8FF 0%, #FFF 100%);
		border: 2px solid #00AFF0;
	}

	.comm-card .icon {
		font-size: 3rem;
		flex-shrink: 0;
	}

	.comm-card .content {
		flex: 1;
	}

	.comm-card h3 {
		color: #041E42;
		font-size: 1.3rem;
		margin-bottom: 0.5rem;
	}

	.comm-card p {
		color: #333;
		line-height: 1.6;
		margin-bottom: 0.75rem;
	}

	.link-button {
		display: inline-block;
		background: linear-gradient(135deg, #833AB4 0%, #E292AA 100%);
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s;
	}

	.link-button:hover {
		transform: scale(1.05);
		box-shadow: 0 4px 12px rgba(131, 58, 180, 0.3);
	}

	.join-code {
		background: white;
		padding: 1rem;
		border-radius: 4px;
		margin: 1rem 0;
		border-left: 4px solid #00AFF0;
	}

	.join-code code {
		font-family: monospace;
		font-size: 1.2rem;
		font-weight: bold;
		color: #041E42;
		background: #F0F8FF;
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
	}

	.note {
		font-size: 0.95rem;
		color: #666;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
	}

	.contact-card {
		background: #F8F9FA;
		padding: 1.5rem;
		border-radius: 8px;
		border-left: 4px solid #041E42;
	}

	.contact-card h3 {
		color: #041E42;
		margin-bottom: 0.75rem;
	}

	.contact-card .name {
		font-weight: 600;
		color: #6A4C93;
		margin-bottom: 0.5rem;
	}

	.contact-card p {
		margin: 0.25rem 0;
		color: #333;
	}

	.contact-card a {
		color: #041E42;
		text-decoration: none;
	}

	.contact-card a:hover {
		color: #E292AA;
		text-decoration: underline;
	}

	.resource-list {
		display: grid;
		gap: 1rem;
	}

	.resource-item {
		background: #F8F9FA;
		padding: 1.5rem;
		border-radius: 8px;
		border-left: 4px solid #E292AA;
	}

	.resource-item h3 {
		color: #041E42;
		margin-bottom: 0.5rem;
	}

	.resource-item p {
		color: #333;
		line-height: 1.6;
		margin: 0;
	}
</style>
