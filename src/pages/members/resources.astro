---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { checkMemberAuth } from '../../utils/auth';
import memberResources from '../../data/memberResources.json';

if (!checkMemberAuth(Astro.request)) {
  return Astro.redirect('/members/login');
}

const resources = Array.isArray(memberResources.resources) ? memberResources.resources : [];
---

<MemberLayout title="Member Resources - Mini-THON">
	<h1>Member Resources</h1>

	<section class="intro">
		<p>Quick access to the documents, templates, and links used by the Mini-THON team.</p>
	</section>

	<section class="resource-grid">
		{resources.length > 0 ? (
			resources.map((resource) => (
				<article class="resource-card">
					<h2>{resource.title}</h2>
					<p>{resource.description}</p>
					<a href={resource.url} target="_blank" rel="noopener noreferrer" class="resource-link">
						Open resource →
					</a>
				</article>
			))
		) : (
			<p class="empty-state">No resources have been added yet.</p>
		)}
	</section>
</MemberLayout>

<style>
	h1 {
		font-size: clamp(2rem, 4vw, 2.6rem);
		color: var(--ink-900);
		margin-bottom: 2rem;
	}

	section {
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		margin-bottom: 2rem;
	}

	.intro p {
		margin: 0;
		font-size: 1.05rem;
		color: var(--ink-700);
		line-height: 1.8;
	}

	.resource-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.resource-card {
		background: linear-gradient(135deg, rgba(106, 170, 228, 0.08), rgba(106, 170, 228, 0.03));
		padding: 1.5rem;
		border-radius: 16px;
		border: 1px solid var(--border-soft);
		box-shadow: var(--shadow-card);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.resource-card h2 {
		font-size: 1.3rem;
		color: var(--ink-900);
		margin: 0;
	}

	.resource-card p {
		color: var(--ink-700);
		line-height: 1.7;
		margin: 0;
		flex: 1;
	}

	.resource-link {
		color: var(--brand-ink);
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease, transform 0.2s ease;
		display: inline-flex;
		gap: 0.4rem;
		align-items: center;
	}

	.resource-link:hover {
		color: var(--brand-sky);
		transform: translateX(4px);
	}

	.empty-state {
		color: var(--ink-500);
		font-size: 1rem;
		margin: 0;
	}

	@media (max-width: 768px) {
		section {
			padding: 1.5rem;
		}
	}
</style>
