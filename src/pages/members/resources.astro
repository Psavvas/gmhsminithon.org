---
import MemberLayout from "../../layouts/MemberLayout.astro";
import { checkMemberAuth } from "../../utils/auth";
import { getMemberResources } from "../../utils/content";

if (!(await checkMemberAuth(Astro.request))) {
  return Astro.redirect("/members/login");
}

const resources = await getMemberResources();
---

<MemberLayout
  title="Member Resources - Mini-THON"
  heading="Member resources"
  intro="The documents, templates, and links the Mini-THON team uses most."
>
  {
    resources.length > 0 ? (
      <div class="mp-cards">
        {resources.map((resource) => (
          <a
            class="mp-card"
            href={resource.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="mp-card__icon" aria-hidden="true">
              📄
            </span>
            <h2 class="mp-card__title">{resource.title}</h2>
            {resource.description && (
              <p class="mp-card__description">{resource.description}</p>
            )}
            <span class="mp-card__link">Open ↗</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="mp-empty">No resources have been added yet.</p>
    )
  }
</MemberLayout>
