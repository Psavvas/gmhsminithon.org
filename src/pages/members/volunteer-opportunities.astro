---
import MemberLayout from '../../layouts/MemberLayout.astro';
import EventCountdown from '../../components/EventCountdown.astro';
import { checkMemberAuth } from '../../utils/auth';

// Check authentication
if (!checkMemberAuth(Astro.request)) {
  return Astro.redirect('/members/login');
}

const eventEntries = await Astro.glob('../events/*.mdx');
const currentYear = new Date().getFullYear();

const events = eventEntries
	.map((entry) => ({
		...entry.frontmatter,
		Content: entry.Content
	}))
	.filter((event) => new Date(event.date).getFullYear() === currentYear)
	.sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

const normalizeParagraphs = (value?: string | string[]) =>
	value
		? Array.isArray(value)
			? value
			: value.split('\n\n').filter(Boolean)
		: [];

const renderInternalParagraph = (paragraph: string) =>
	paragraph.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');

// Format full date
const getFullDate = (dateString: string) => new Date(dateString).toLocaleDateString('en-US', { 
	weekday: 'long',
	year: 'numeric',
	month: 'long',
	day: 'numeric'
});
---

<MemberLayout title="Volunteer Opportunities - Mini-THON">
	<h1>Volunteer Opportunities</h1>
	
	<section class="intro">
		<p>Sign up for volunteer shifts for our upcoming events! Each event has specific volunteer needs listed below.</p>
	</section>

	{events.length === 0 ? (
		<section class="no-events">
			<p>No volunteer opportunities scheduled for {currentYear} yet. Check back soon!</p>
		</section>
	) : (
		<div class="events-grid">
			{events.map(event => (
				<article class="event-card">
					<div class="event-hero">
						<div class="event-hero-content">
							<div class="event-meta">
								<span class={`event-type ${event.event_type}`}>{event.event_type}</span>
							</div>
							<h2>{event.title}</h2>
							<div class="event-info-row">
								<div class="event-info-item">
									<div class="info-content">
										<span class="info-label">Date</span>
										<time datetime={event.date}>{getFullDate(event.date)}</time>
									</div>
								</div>
								{event.location && (
									<div class="event-info-item">
										<div class="info-content">
											<span class="info-label">Location</span>
											<span>{event.location}</span>
										</div>
									</div>
								)}
							</div>
						</div>
						<div class="event-countdown-wrapper">
							<EventCountdown eventDate={event.date} />
						</div>
					</div>
					
					<div class="event-sections">
						<div class="public-info">
							<h3>About This Event</h3>
							<event.Content />
						</div>

						<div class="member-info">
							<h3>Volunteer Information</h3>
							{normalizeParagraphs(event.internal_description).map((paragraph) => (
								<div class="internal-description" set:html={renderInternalParagraph(paragraph)} />
							))}
						</div>
					</div>

						{event.links && event.links.length > 0 && (
						<div class="event-links">
							<h4>Related Links</h4>
							<ul>
									{event.links.map(link => (
									<li>
										<a href={link} target="_blank" rel="noopener noreferrer">{link}</a>
									</li>
								))}
							</ul>
						</div>
					)}
				</article>
			))}
		</div>
	)}
</MemberLayout>

<style>
	h1 {
		font-size: clamp(2rem, 4vw, 2.5rem);
		color: var(--ink-900);
		margin-bottom: 2rem;
		animation: fade-rise 0.6s ease both;
	}

	.intro {
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		margin-bottom: 2rem;
		font-size: 1.1rem;
		line-height: 1.8;
		color: var(--ink-700);
		animation: fade-rise 0.6s ease both;
		animation-delay: 0.05s;
	}

	.intro p {
		margin: 0;
	}

	.no-events {
		background: var(--surface-raised);
		padding: 3rem 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		text-align: center;
		font-size: 1.2rem;
		color: var(--ink-500);
		animation: fade-rise 0.8s ease both;
	}

	.no-events p {
		margin: 0;
	}

	.events-grid {
		display: grid;
		gap: 2.5rem;
	}

	.event-card {
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		animation: fade-rise 0.8s ease both;
	}

	.event-hero {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 2rem;
		align-items: start;
		margin-bottom: 2rem;
		padding-bottom: 2rem;
		border-bottom: 2px solid var(--border-soft);
	}

	.event-hero-content {
		flex: 1;
	}

	.event-meta {
		margin-bottom: 1rem;
	}

	.event-type {
		display: inline-block;
		padding: 0.35rem 0.9rem;
		border-radius: 12px;
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.event-type.gaming {
		background: #E3F2FD;
		color: #1976D2;
	}

	.event-type.dine-to-donate {
		background: #FFF3E0;
		color: #F57C00;
	}

	.event-type.fundraiser {
		background: #F3E5F5;
		color: #7B1FA2;
	}

	.event-card h2 {
		font-size: clamp(1.5rem, 3vw, 1.8rem);
		color: var(--ink-900);
		margin: 0 0 1.5rem 0;
		line-height: 1.2;
	}

	.event-info-row {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1rem;
	}

	.event-info-item {
		display: flex;
		align-items: center;
	}

	.info-content {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.info-label {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-500);
	}

	.info-content time,
	.info-content span {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--ink-900);
	}

	.event-countdown-wrapper {
		min-width: 280px;
	}

	.event-sections {
		display: grid;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.public-info h3,
	.member-info h3 {
		font-size: 1.2rem;
		color: var(--ink-900);
		margin-bottom: 1rem;
	}

	.public-info :global(p),
	.internal-description {
		line-height: 1.8;
		color: var(--ink-700);
		font-size: 1.05rem;
	}

	.member-info {
		background: linear-gradient(135deg, rgba(253, 185, 39, 0.12), rgba(253, 185, 39, 0.05));
		padding: 1.75rem;
		border-radius: 16px;
		border-left: 4px solid #FDB927;
	}

	.member-info h3 {
		color: #8B4513;
	}

	.internal-description {
		margin-bottom: 0.75rem;
	}

	.internal-description:last-child {
		margin-bottom: 0;
	}

	.event-links {
		background: linear-gradient(135deg, rgba(106, 170, 228, 0.08), rgba(106, 170, 228, 0.03));
		padding: 1.5rem;
		border-radius: 16px;
		border: 1px solid var(--border-soft);
	}

	.event-links h4 {
		font-size: 1.1rem;
		color: var(--brand-ink);
		margin-bottom: 1rem;
	}

	.event-links ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}

	.event-links li {
		margin: 0;
	}

	.event-links a {
		color: var(--brand-ink);
		text-decoration: none;
		word-break: break-all;
		font-size: 0.95rem;
		transition: color 0.2s ease;
		display: inline-block;
		padding: 0.25rem 0;
	}

	.event-links a:hover {
		color: var(--brand-sky);
		text-decoration: underline;
	}

	@keyframes fade-rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		.event-hero {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.event-countdown-wrapper {
			min-width: auto;
		}

		.event-card {
			padding: 1.5rem;
		}

		.event-info-row {
			flex-direction: column;
			gap: 1rem;
		}

		.member-info {
			padding: 1.25rem;
		}
	}
</style>
