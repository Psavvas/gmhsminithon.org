---
import MemberLayout from "../../../layouts/MemberLayout.astro";
import EventCountdown from "../../../components/EventCountdown.astro";
import { checkMemberAuth } from "../../../utils/auth";
import { renderContentMarkdown } from "../../../utils/markdown";
import {
  formatEventDate,
  getEventBySlug,
  getEventDateTimeValue,
  getEventTypeClass,
  renderManagedEventBody,
} from "../../../utils/events";

// Check authentication
if (!(await checkMemberAuth(Astro.request))) {
  return Astro.redirect("/members/login");
}

const { slug } = Astro.params;
const event = await getEventBySlug(slug!);

if (!event) {
  return Astro.redirect("/members/upcoming-events");
}

const {
  title,
  date,
  time,
  location,
  event_type: eventType,
  links = [],
} = event;

const fullDate = formatEventDate(date, time);
const eventDateTime = getEventDateTimeValue(date, time);

const startOfToday = new Date();
startOfToday.setHours(0, 0, 0, 0);
const eventDay = new Date(eventDateTime);
const isPast = !Number.isNaN(eventDay.getTime()) && eventDay < startOfToday;

// Parse member details from raw MDX content
const eventFiles = import.meta.glob("/src/pages/events/*.mdx", {
  as: "raw",
  eager: true,
});
const rawContent = (eventFiles as Record<string, string>)[
  `/src/pages/events/${slug}.mdx`
];

let memberDetailsMarkdown: string | null = null;
if (rawContent) {
  const match = rawContent.match(
    /<Fragment slot="member-details">([\s\S]*?)<\/Fragment>/,
  );
  memberDetailsMarkdown = match ? match[1].trim() : null;
}

// Helper to render markdown as HTML
const renderMarkdown = (markdown: string) => {
  if (!markdown) return "";

  let html = markdown;

  // Collapse multi-line HTML tags into single lines
  html = html.replace(/<[a-zA-Z][a-zA-Z0-9]*\b[^>]*>/g, (match) => {
    if (match.includes("\n")) {
      return match.replace(/\n\s*/g, " ");
    }
    return match;
  });

  // Replace headings
  html = html.replace(/^### (.+)$/gm, "<h4>$1</h4>");
  html = html.replace(/^## (.+)$/gm, "<h3>$1</h3>");
  html = html.replace(/^# (.+)$/gm, "<h2>$1</h2>");

  // Replace bold text (must run before italic)
  html = html.replace(/\*\*([\s\S]*?)\*\*/g, "<strong>$1</strong>");

  // Replace markdown links [text](url)
  html = html.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>',
  );

  // Replace italic text (single * only, bold already replaced)
  html = html.replace(/(?<!\*)\*(?!\*)([^*]+)\*(?!\*)/g, "<em>$1</em>");

  // Process lists
  const lines = html.split("\n");
  const processedLines: string[] = [];
  let inList = false;

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const trimmedLine = line.trim();

    if (trimmedLine.startsWith("- ")) {
      if (!inList) {
        processedLines.push("<ul>");
        inList = true;
      }
      processedLines.push(`<li>${trimmedLine.substring(2)}</li>`);
    } else if (trimmedLine === "") {
      if (inList) {
        processedLines.push("</ul>");
        inList = false;
      }
      processedLines.push("");
    } else {
      if (inList) {
        processedLines.push("</ul>");
        inList = false;
      }
      // Wrap non-heading, non-tag lines in <p> tags
      if (!trimmedLine.startsWith("<")) {
        processedLines.push(`<p>${line}</p>`);
      } else {
        processedLines.push(line);
      }
    }
  }

  if (inList) {
    processedLines.push("</ul>");
  }

  return processedLines.join("\n");
};

// Extract public body content (everything outside frontmatter and member-details Fragment)
let publicBodyHtml = "";
if (rawContent) {
  // Extract import variable mappings (e.g., import flyer from 'https://wzec6kbgu0.ufs.sh/f/f6kAnf2T9Q2Z1iVVxHqykyujcLaKXDGJb4sxtT9idN57nwgf')
  const importMap: Record<string, string> = {};
  const importRegex = /import\s+(\w+)\s+from\s+['"]([^'"]+)['"]/g;
  let importMatch;
  while ((importMatch = importRegex.exec(rawContent)) !== null) {
    let importPath = importMatch[2];
    // Convert /public/ paths to / for web serving
    if (importPath.startsWith("/public/")) {
      importPath = importPath.replace("/public/", "/");
    }
    importMap[importMatch[1]] = importPath;
  }

  let body = rawContent
    .replace(/---[\s\S]*?---/, "") // Remove frontmatter
    .replace(/import[\s\S]*?;\n?/g, "") // Remove import statements
    .replace(/<Fragment[\s\S]*?<\/Fragment>/g, "") // Remove <Fragment> blocks
    .trim();

  // Convert <Image src={varName} ... /> to <img src="path" ... />
  body = body.replace(/<Image\s+([\s\S]*?)\/>/g, (_, attrs) => {
    let imgAttrs = attrs;
    // Replace src={variable} with src="resolved-path"
    imgAttrs = imgAttrs.replace(
      /src=\{(\w+)\}/g,
      (_m: string, varName: string) => {
        const resolved = importMap[varName] || "";
        return `src="${resolved}"`;
      },
    );
    // Remove unsupported Astro-specific attributes
    imgAttrs = imgAttrs.replace(
      /\s*(loading|decoding|fetchpriority)="[^"]*"/g,
      "",
    );
    imgAttrs = imgAttrs.replace(/\s+/g, " ").trim();
    return `<img ${imgAttrs} />`;
  });

  publicBodyHtml = renderMarkdown(body);
}

// Events created in the admin portal store their content as Markdown instead of
// living in an .mdx file, and are rendered with the escaping renderer.
if (event.source === "managed") {
  publicBodyHtml = renderManagedEventBody(event);
}

const memberDetailsHtml =
  event.source === "managed"
    ? renderContentMarkdown(event.memberDetailsMarkdown)
    : memberDetailsMarkdown
      ? renderMarkdown(memberDetailsMarkdown)
      : "";
---

<MemberLayout title={`${title} - Mini-THON`}>
  <div class="mp-page-header">
    <div class="mp-event__head">
      <span class={`mp-badge mp-type--${getEventTypeClass(eventType)}`}>
        {eventType}
      </span>
      {isPast && <span class="mp-badge mp-badge--muted">Past event</span>}
    </div>
    <h1>{title}</h1>
    <p class="mp-page-header__intro">
      <time datetime={eventDateTime}>{fullDate}</time>
      {location ? ` · ${location}` : ""}
    </p>
  </div>

  {!isPast && <EventCountdown eventDate={eventDateTime} />}

  {
    memberDetailsHtml && (
      <section class="mp-panel">
        <h2 class="mp-panel__title">
          Member details
          <span class="mp-badge mp-badge--members">Members only</span>
        </h2>
        <div class="mp-prose" set:html={memberDetailsHtml} />
      </section>
    )
  }

  <section class="mp-panel">
    <h2 class="mp-panel__title">About this event</h2>
    <div class="mp-prose" set:html={publicBodyHtml} />
  </section>

  {
    (links as string[]).length > 0 && (
      <section class="mp-panel">
        <h2 class="mp-panel__title">Related links</h2>
        <ul class="mp-stack">
          {(links as string[]).map((link: string) => (
            <li>
              <a
                class="mp-link"
                href={link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p>
    <a class="mp-button mp-button--ghost" href="/members/upcoming-events">
      ← Back to events
    </a>
  </p>
</MemberLayout>
