---
import MemberLayout from "../../layouts/MemberLayout.astro";
import { checkMemberAuth } from "../../utils/auth";
import { getMemberAnnouncements } from "../../utils/content";
import {
  normalizeAnnouncements,
  renderAnnouncementMdx,
  sortAnnouncementsPinnedThenDate,
} from "../../utils/announcements";

if (!(await checkMemberAuth(Astro.request))) {
  return Astro.redirect("/members/login");
}

const announcements = sortAnnouncementsPinnedThenDate(
  normalizeAnnouncements(await getMemberAnnouncements()),
);
---

<MemberLayout
  title="Announcements - Mini-THON Members"
  heading="Announcements"
  intro="Updates about upcoming events, volunteer needs, and anything else the team should know."
>
  {
    announcements.length > 0 ? (
      <div class="mp-stack">
        {announcements.map((announcement) => (
          <article
            class={`mp-announcement${announcement.type === "urgent" ? " mp-announcement--urgent" : ""}`}
          >
            <div class="mp-announcement__head">
              <h2 class="mp-announcement__title">{announcement.title}</h2>
              <div class="mp-announcement__meta">
                {announcement.pin && (
                  <span class="mp-badge mp-badge--pinned">Pinned</span>
                )}
                {announcement.type === "urgent" && (
                  <span class="mp-badge mp-badge--urgent">Urgent</span>
                )}
                {announcement.dateAdded && (
                  <time datetime={announcement.dateAdded}>
                    {new Date(announcement.dateAdded).toLocaleDateString(
                      "en-US",
                      { year: "numeric", month: "short", day: "numeric" },
                    )}
                  </time>
                )}
              </div>
            </div>
            <div
              class="mp-prose"
              set:html={renderAnnouncementMdx(announcement.descriptionMdx)}
            />
          </article>
        ))}
      </div>
    ) : (
      <p class="mp-empty">No announcements yet.</p>
    )
  }
</MemberLayout>
