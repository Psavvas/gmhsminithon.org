---
import MemberLayout from "../../layouts/MemberLayout.astro";
import { checkMemberAuth } from "../../utils/auth";
import RefreshMemberCacheButton from "../../components/member-auth/RefreshMemberCacheButton";
import { getMemberAnnouncements } from "../../utils/content";
import PortalIcon from "../../components/PortalIcon.astro";
import {
  formatEventDate,
  getCurrentYearEvents,
  getEventTypeClass,
} from "../../utils/events";
import {
  getPinnedAnnouncements,
  normalizeAnnouncements,
  renderAnnouncementMdx,
} from "../../utils/announcements";

// Check authentication
if (!(await checkMemberAuth(Astro.request))) {
  return Astro.redirect("/members/login");
}

const today = new Date();
today.setHours(0, 0, 0, 0);

const currentYearEvents = await getCurrentYearEvents();

const upcomingEvents = currentYearEvents
  .filter((event) => new Date(event.date) >= today)
  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  .slice(0, 3);

const allAnnouncements = normalizeAnnouncements(await getMemberAnnouncements());
const announcements = getPinnedAnnouncements(allAnnouncements);

const quickActions = [
  {
    href: "/members/upcoming-events",
    icon: "calendar",
    title: "Upcoming Events",
    description: "See what is coming up and sign up for shifts.",
  },
  {
    href: "/members/announcements",
    icon: "megaphone",
    title: "Announcements",
    description: "Read pinned updates and recent posts.",
  },
  {
    href: "/members/club-info",
    icon: "building",
    title: "Club Info",
    description: "Meeting times, officers, and where we post updates.",
  },
  {
    href: "/members/resources",
    icon: "book",
    title: "Member Resources",
    description: "Quick links to files, forms, and templates.",
  },
];
---

<MemberLayout
  title="Member Dashboard - Mini-THON"
  heading="Member portal"
  intro="Everything the team needs in one place: what is coming up, what changed, and where the files live."
>
  <section class="mp-panel">
    <h2 class="mp-panel__title">Pinned announcements</h2>
    {
      announcements.length > 0 ? (
        <div class="mp-stack">
          {announcements.map((announcement) => (
            <article
              class={`mp-announcement${announcement.type === "urgent" ? " mp-announcement--urgent" : ""}`}
            >
              <div class="mp-announcement__head">
                <h3 class="mp-announcement__title">{announcement.title}</h3>
                {announcement.dateAdded && (
                  <span class="mp-announcement__meta">
                    <time datetime={announcement.dateAdded}>
                      {new Date(announcement.dateAdded).toLocaleDateString(
                        "en-US",
                        { month: "short", day: "numeric" },
                      )}
                    </time>
                  </span>
                )}
              </div>
              <div
                class="mp-prose"
                set:html={renderAnnouncementMdx(announcement.descriptionMdx)}
              />
            </article>
          ))}
        </div>
      ) : (
        <p class="mp-empty">
          Nothing pinned right now. The announcements page has everything else.
        </p>
      )
    }
    <p>
      <a class="mp-link" href="/members/announcements"
        >View all announcements →</a
      >
    </p>
  </section>

  <section class="mp-stack">
    <h2 class="mp-section-title">Quick actions</h2>
    <div class="mp-cards">
      {
        quickActions.map((action) => (
          <a class="mp-card" href={action.href}>
            <span class="mp-card__icon">
              <PortalIcon name={action.icon} size={22} />
            </span>
            <h3 class="mp-card__title">{action.title}</h3>
            <p class="mp-card__description">{action.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mp-panel">
    <h2 class="mp-panel__title">Next up</h2>
    {
      upcomingEvents.length > 0 ? (
        <div class="mp-stack">
          {upcomingEvents.map((event) => (
            <article class="mp-event">
              <div class="mp-event__head">
                <span
                  class={`mp-badge mp-type--${getEventTypeClass(event.event_type)}`}
                >
                  {event.event_type}
                </span>
                <h3 class="mp-event__title">{event.title}</h3>
              </div>
              <p class="mp-event__meta">
                {formatEventDate(event.date, event.time)}
                {event.location ? ` · ${event.location}` : ""}
              </p>
              <div class="mp-event__actions">
                <a
                  class="mp-button mp-button--secondary mp-button--small"
                  href={`/members/events/${event.url.replace("/events/", "")}`}
                >
                  Event details
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="mp-empty">No upcoming events right now.</p>
      )
    }
    <p>
      <a class="mp-link" href="/members/upcoming-events">View all events →</a>
    </p>
  </section>

  <section class="mp-panel">
    <details class="mp-details">
      <summary>Portal tools</summary>
      <p class="mp-panel__note">
        If someone was just approved, refresh the shared member cache so they
        can sign in without waiting.
      </p>
      <RefreshMemberCacheButton
        client:idle
        endpoint="/api/member-auth/refresh-cache"
      />
    </details>
  </section>
</MemberLayout>
