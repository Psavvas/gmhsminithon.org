---
import MemberLayout from "../../layouts/MemberLayout.astro";
import { checkMemberAuth } from "../../utils/auth";
import {
  formatEventDate,
  getCurrentYearEvents,
  getEventDateTimeValue,
  getEventTypeClass,
  splitEventsByDate,
} from "../../utils/events";

// Check authentication
if (!(await checkMemberAuth(Astro.request))) {
  return Astro.redirect("/members/login");
}

const currentYear = new Date().getFullYear();
const events = await getCurrentYearEvents();
const { upcomingEvents, pastEvents } = splitEventsByDate(events);
const pastEventsNewestFirst = [...pastEvents].reverse();

const formatDescription = (content: string | string[] | undefined) => {
  if (!content) return "";
  return Array.isArray(content) ? content.join(" ") : content;
};

const getMemberEventUrl = (publicUrl: string | undefined) => {
  if (!publicUrl) return "/members/upcoming-events";
  return `/members/events/${publicUrl.replace("/events/", "")}`;
};
---

<MemberLayout
  title="Events - Mini-THON"
  heading="Events"
  intro="Open an event for member-only details, volunteer needs, and sign-up links."
>
  {
    upcomingEvents.length === 0 && pastEvents.length === 0 ? (
      <p class="mp-empty">No events scheduled for {currentYear} yet.</p>
    ) : (
      <>
        <section class="mp-panel">
          <h2 class="mp-panel__title">
            Upcoming
            <span class="mp-badge mp-badge--muted">
              {upcomingEvents.length}
            </span>
          </h2>
          {upcomingEvents.length > 0 ? (
            <div class="mp-stack">
              {upcomingEvents.map((event) => (
                <article class="mp-event">
                  <div class="mp-event__head">
                    <span
                      class={`mp-badge mp-type--${getEventTypeClass(event.event_type)}`}
                    >
                      {event.event_type}
                    </span>
                    <h3 class="mp-event__title">{event.title}</h3>
                  </div>
                  <p class="mp-event__meta">
                    <time
                      datetime={getEventDateTimeValue(event.date, event.time)}
                    >
                      {formatEventDate(event.date, event.time)}
                    </time>
                    {event.location ? ` · ${event.location}` : ""}
                  </p>
                  <p class="mp-event__summary">
                    {formatDescription(event.summary)}
                  </p>
                  <div class="mp-event__actions">
                    <a
                      class="mp-button mp-button--secondary mp-button--small"
                      href={getMemberEventUrl(event.url)}
                    >
                      Details and sign-up
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="mp-empty">
              No upcoming events for {currentYear}. Check back soon.
            </p>
          )}
        </section>

        {pastEventsNewestFirst.length > 0 && (
          <section class="mp-panel">
            <h2 class="mp-panel__title">
              Past
              <span class="mp-badge mp-badge--muted">
                {pastEventsNewestFirst.length}
              </span>
            </h2>
            <div class="mp-stack">
              {pastEventsNewestFirst.map((event) => (
                <article class="mp-event mp-event--past">
                  <div class="mp-event__head">
                    <span
                      class={`mp-badge mp-type--${getEventTypeClass(event.event_type)}`}
                    >
                      {event.event_type}
                    </span>
                    <h3 class="mp-event__title">{event.title}</h3>
                  </div>
                  <p class="mp-event__meta">
                    <time
                      datetime={getEventDateTimeValue(event.date, event.time)}
                    >
                      {formatEventDate(event.date, event.time)}
                    </time>
                    {event.location ? ` · ${event.location}` : ""}
                  </p>
                  <div class="mp-event__actions">
                    <a
                      class="mp-button mp-button--ghost mp-button--small"
                      href={getMemberEventUrl(event.url)}
                    >
                      Event details
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}
      </>
    )
  }
</MemberLayout>
