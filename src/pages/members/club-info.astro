---
import MemberLayout from '../../layouts/MemberLayout.astro';
import { checkMemberAuth } from '../../utils/auth';
import clubInfo from '../../data/clubInfo.json';

// Check authentication
if (!checkMemberAuth(Astro.request)) {
  return Astro.redirect('/members/login');
}
---

<MemberLayout title="Meeting Info - Mini-THON">
	<h1>Meeting Information</h1>
	
	<section class="meeting-schedule">
		<h2>📅 Meeting Schedule</h2>
		<div class="meeting-card">
			<h3>General Meetings</h3>
			<p class="time">{clubInfo.meetings.general}</p>
			<p class="description">All members are welcome! We discuss upcoming events, fundraising updates, and club business.</p>
		</div>
		<div class="meeting-card board">
			<h3>Board Meetings</h3>
			<p class="time">{clubInfo.meetings.board}</p>
			<p class="description">Strategic planning and event logistics geared meeting..</p>
		</div>
	</section>

	<section class="communication">
		<h2>💬 Stay Connected</h2>
		
		<div class="comm-card instagram">
			<div class="icon">📸</div>
			<div class="content">
				<h3>Instagram</h3>
				<p>Follow us for updates, event photos, and announcements</p>
				<a href={clubInfo.socialMedia.instagram} target="_blank" rel="noopener noreferrer" class="link-button">
					Follow @gmhsminithon
				</a>
			</div>
		</div>
		
		<div class="comm-card facebook">
			<div class="icon">📱</div>
			<div class="content">
				<h3>Facebook</h3>
				<p>Follow Mini-THON's Facebook page for updates and announcements.</p>
				<a href={clubInfo.socialMedia.facebook} target="_blank" rel="noopener noreferrer" class="link-button">
					Follow @gmhsftk
				</a>
			</div>
		</div>

		<div class="comm-card tiktok">
			<div class="icon">📷</div>
			<div class="content">
				<h3>TikTok</h3>
				<p>{clubInfo.socialMedia.tiktok}</p>
				<p class="note">Updates and upcoming events posted here!</p>
			</div>
		</div>

		<div class="comm-card groupme">
			<div class="icon">💬</div>
			<div class="content">
				<h3>GroupMe</h3>
				<p>{clubInfo.socialMedia.groupme}</p>
				<p class="note">Ask a club officer for the GroupMe join link.</p>
			</div>
		</div>

	</section>

	<section class="contacts">
		<h2>📞 Key Contact Information</h2>
		<div class="contact-grid">
			{clubInfo.officers.map(officer => (
				<div class="contact-card">
					<h3>{officer.role === 'Adult Coordinator' ? 'Adult Sponsor' : officer.role}</h3>
					<p class="name">{officer.name}</p>
					<p><a href={`mailto:${officer.email}`}>{officer.email}</a></p>
				</div>
			))}
		</div>
	</section>

	<section class="resources">
		<h2>📚 Member Resources</h2>
		<p class="resource-note">Find templates, graphics, and shared files in the Member Resources library.</p>
		<a href="/members/resources" class="resource-link">Go to Member Resources →</a>
	</section>
</MemberLayout>

<style>
	h1 {
		font-size: clamp(2rem, 4vw, 2.6rem);
		color: var(--ink-900);
		margin-bottom: 2rem;
	}

	section {
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		margin-bottom: 2rem;
	}

	h2 {
		font-size: clamp(1.5rem, 3vw, 1.9rem);
		color: var(--ink-900);
		margin-bottom: 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--brand-sky);
	}

	.meeting-card {
		background: linear-gradient(135deg, rgba(106, 170, 228, 0.08), rgba(106, 170, 228, 0.03));
		padding: 1.5rem;
		border-radius: 16px;
		margin-bottom: 1rem;
		border: 1px solid var(--border-soft);
		border-left: 4px solid var(--brand-sky);
	}

	.meeting-card.board {
		border-left-color: #FDB927;
		background: linear-gradient(135deg, rgba(253, 185, 39, 0.16), rgba(255, 255, 255, 0.7));
	}

	.meeting-card h3 {
		color: var(--ink-900);
		font-size: 1.3rem;
		margin-bottom: 0.5rem;
	}

	.meeting-card .time {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--brand-ink);
		margin-bottom: 0.75rem;
	}

	.meeting-card .description {
		color: var(--ink-700);
		line-height: 1.6;
		margin: 0;
	}

	.comm-card {
		display: flex;
		gap: 1.5rem;
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 16px;
		margin-bottom: 1.5rem;
		align-items: flex-start;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
	}

	.comm-card.instagram {
		background: linear-gradient(135deg, rgba(225, 48, 108, 0.1), rgba(255, 255, 255, 0.8));
		border: 1px solid rgba(225, 48, 108, 0.3);
	}

	.comm-card.groupme {
		background: linear-gradient(135deg, rgba(0, 175, 240, 0.12), rgba(255, 255, 255, 0.8));
		border: 1px solid rgba(0, 175, 240, 0.3);
	}

	.comm-card.facebook {
		background: linear-gradient(135deg, #b4cee7, rgba(255, 255, 255, 0.8));
		border: 1px solid #4f719e;
	}

	.com-card.tiktok {
		background: linear-gradient(135deg, #fec4cf, rgba(255, 255, 255, 0.8));
		border: 1px solid #ff5876;
	}

	.comm-card .icon {
		font-size: 3rem;
		flex-shrink: 0;
	}

	.comm-card .content {
		flex: 1;
	}

	.comm-card h3 {
		color: var(--ink-900);
		font-size: 1.3rem;
		margin-bottom: 0.5rem;
	}

	.comm-card p {
		color: var(--ink-700);
		line-height: 1.6;
		margin-bottom: 0.75rem;
	}

	.link-button {
		display: inline-block;
		background: linear-gradient(135deg, #833AB4 0%, #E1306C 100%);
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		transition: all 0.3s ease;
	}

	.link-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(131, 58, 180, 0.3);
	}

	.join-code {
		background: var(--white);
		padding: 1rem;
		border-radius: 12px;
		margin: 1rem 0;
		border-left: 4px solid #00AFF0;
		border: 1px solid rgba(0, 175, 240, 0.2);
	}

	.join-code code {
		font-family: monospace;
		font-size: 1.2rem;
		font-weight: bold;
		color: var(--ink-900);
		background: rgba(0, 175, 240, 0.08);
		padding: 0.25rem 0.5rem;
		border-radius: 8px;
	}

	.note {
		font-size: 0.95rem;
		color: var(--ink-500);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
	}

	.contact-card {
		background: var(--surface-raised);
		padding: 1.5rem;
		border-radius: 16px;
		border: 1px solid var(--border-soft);
		border-left: 4px solid var(--brand-ink);
	}

	.contact-card h3 {
		color: var(--ink-900);
		margin-bottom: 0.75rem;
	}

	.contact-card .name {
		font-weight: 600;
		color: var(--brand-ink);
		margin-bottom: 0.5rem;
	}

	.contact-card p {
		margin: 0.25rem 0;
		color: var(--ink-700);
	}

	.contact-card a {
		color: var(--brand-ink);
		text-decoration: none;
	}

	.contact-card a:hover {
		text-decoration: underline;
	}

	.resource-note {
		color: var(--ink-700);
		font-size: 1.05rem;
		line-height: 1.7;
		margin-bottom: 1rem;
	}

	.resource-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--brand-ink);
		font-weight: 600;
		text-decoration: none;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.resource-link:hover {
		color: var(--brand-sky);
		transform: translateX(4px);
	}

	@media (max-width: 768px) {
		section {
			padding: 1.5rem;
		}

		.comm-card {
			flex-direction: column;
		}
	}
</style>
