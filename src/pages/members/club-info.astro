---
import MemberLayout from "../../layouts/MemberLayout.astro";
import { checkMemberAuth } from "../../utils/auth";
import { getClubInfo } from "../../utils/content";

// Check authentication
if (!(await checkMemberAuth(Astro.request))) {
  return Astro.redirect("/members/login");
}

const clubInfo = await getClubInfo();

function isLink(value: string): boolean {
  return /^https?:\/\//i.test(value);
}

const socialLinks = [
  {
    key: "instagram",
    icon: "📸",
    name: "Instagram",
    blurb: "Updates, event photos, and announcements.",
    value: clubInfo.socialMedia.instagram,
    cta: "Follow on Instagram",
  },
  {
    key: "facebook",
    icon: "👍",
    name: "Facebook",
    blurb: "Event updates for families and the community.",
    value: clubInfo.socialMedia.facebook,
    cta: "Follow on Facebook",
  },
  {
    key: "tiktok",
    icon: "🎵",
    name: "TikTok",
    blurb: "Short updates and upcoming event teasers.",
    value: clubInfo.socialMedia.tiktok,
    cta: "Follow on TikTok",
  },
  {
    key: "groupme",
    icon: "💬",
    name: "GroupMe",
    blurb: "Day-to-day chat for members.",
    value: clubInfo.socialMedia.groupme,
    cta: "Open GroupMe",
  },
].filter((entry) => entry.value);
---

<MemberLayout
  title="Club Info - Mini-THON"
  heading="Club info"
  intro="When we meet, where we post updates, and who to contact."
>
  <section class="mp-panel">
    <h2 class="mp-panel__title">
      <span aria-hidden="true">📅</span> Meetings
    </h2>
    <div class="mp-cards">
      <div class="mp-card">
        <h3 class="mp-card__title">General meetings</h3>
        <p class="mp-card__value">{clubInfo.meetings.general}</p>
        <p class="mp-card__description">
          Open to all members. Upcoming events, fundraising updates, and club
          business.
        </p>
      </div>
      <div class="mp-card">
        <h3 class="mp-card__title">Board meetings</h3>
        <p class="mp-card__value">{clubInfo.meetings.board}</p>
        <p class="mp-card__description">
          Planning and event logistics with the officer team.
        </p>
      </div>
    </div>
  </section>

  <section class="mp-panel">
    <h2 class="mp-panel__title">
      <span aria-hidden="true">💬</span> Stay connected
    </h2>
    <div class="mp-cards">
      {
        socialLinks.map((entry) =>
          isLink(entry.value) ? (
            <a
              class="mp-card"
              href={entry.value}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="mp-card__icon" aria-hidden="true">
                {entry.icon}
              </span>
              <h3 class="mp-card__title">{entry.name}</h3>
              <p class="mp-card__description">{entry.blurb}</p>
              <span class="mp-card__link">{entry.cta} ↗</span>
            </a>
          ) : (
            <div class="mp-card">
              <span class="mp-card__icon" aria-hidden="true">
                {entry.icon}
              </span>
              <h3 class="mp-card__title">{entry.name}</h3>
              <p class="mp-card__description">{entry.value}</p>
              <p class="mp-card__meta">Ask an officer for the join link.</p>
            </div>
          ),
        )
      }
    </div>
  </section>

  <section class="mp-panel">
    <h2 class="mp-panel__title">
      <span aria-hidden="true">📞</span> Who to contact
    </h2>
    <div class="mp-cards">
      {
        clubInfo.officers.map((officer) => (
          <div class="mp-card">
            <dl class="mp-definition">
              <dt>
                {officer.role === "Adult Coordinator"
                  ? "Adult Sponsor"
                  : officer.role}
              </dt>
              <dd>{officer.name}</dd>
            </dl>
            {officer.email && (
              <a class="mp-card__link" href={`mailto:${officer.email}`}>
                {officer.email}
              </a>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="mp-panel">
    <h2 class="mp-panel__title">
      <span aria-hidden="true">📚</span> Files and templates
    </h2>
    <p class="mp-panel__note">
      Shared drives, forms, and brand assets live in the member resources
      library.
    </p>
    <p>
      <a class="mp-button mp-button--secondary" href="/members/resources">
        Go to member resources
      </a>
    </p>
  </section>
</MemberLayout>
