---
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout title="See You Next Year – GMHS Mini-THON">
  <div class="coming-soon-container">
    <div class="coming-soon-card">
      <p class="year-badge">2026 – 2027</p>
      <h1>Something great is coming</h1>
      <p class="coming-soon-message">
        Thank you for being part of the GMHS Mini-THON family. We've wrapped up
        an incredible year and are already hard at work preparing for the
        2026–2027 school year. Stay tuned — bigger events, more impact, and
        even more reasons to fight for the kids.
      </p>
      <p class="coming-soon-sub">
        Have questions? We'd love to hear from you.
      </p>
      <a
        href="mailto:hello@gmhsminithon.org"
        class="button primary"
        aria-label="Email us at hello@gmhsminithon.org"
      >
        hello@gmhsminithon.org
      </a>
    </div>
  </div>
</PublicLayout>

<style>
  .coming-soon-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 2rem 1rem;
  }

  .coming-soon-card {
    background: var(--surface-raised);
    border-radius: 24px;
    padding: 3.5rem 3rem;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--border-soft);
    max-width: 600px;
    width: 100%;
    text-align: center;
    animation: fade-rise 0.6s ease both;
  }

  .year-badge {
    font-size: clamp(3.5rem, 12vw, 6rem);
    font-weight: 700;
    line-height: 1;
    margin: 0 0 0.5rem;
    background: linear-gradient(135deg, var(--brand-ink), var(--brand-sky));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    margin-bottom: 1.25rem;
  }

  .coming-soon-message {
    color: var(--ink-700);
    line-height: 1.8;
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  .coming-soon-sub {
    color: var(--ink-500);
    line-height: 1.8;
    margin-bottom: 2rem;
    font-size: 1rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.8rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    border: 1px solid transparent;
  }

  .button.primary {
    background: var(--brand-sky);
    color: var(--brand-ink);
    box-shadow: 0 14px 25px rgba(106, 170, 228, 0.3);
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 35px rgba(28, 42, 58, 0.18);
  }

  @keyframes fade-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 480px) {
    .coming-soon-card {
      padding: 2.5rem 1.5rem;
    }

    .button {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
