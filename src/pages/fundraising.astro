---
import PublicLayout from '../layouts/PublicLayout.astro';
import fundraisingData from '../data/fundraising.json';

export const prerender = true;

const currentTotal = fundraisingData.currentTotal.toLocaleString('en-US', { 
	style: 'currency', 
	currency: 'USD',
	minimumFractionDigits: 2,
	maximumFractionDigits: 2
});

const allTimeTotal = fundraisingData.history.reduce((sum, year) => sum + year.total, fundraisingData.currentTotal);
const formattedAllTime = allTimeTotal.toLocaleString('en-US', { 
	style: 'currency', 
	currency: 'USD',
	minimumFractionDigits: 0,
	maximumFractionDigits: 0
});
---

<PublicLayout title="Fundraising - Mini-THON">
	<h1>Fundraising</h1>
	
	<section class="current-year">
		<h2>{fundraisingData.currentYear} Fundraising</h2>
		<div class="total-display">
			<span class="label">Current Total</span>
			<span class="amount">{currentTotal}</span>
		</div>
		<p>Every dollar raised goes directly to Four Diamonds and Penn State Hershey Children's Hospital to support families fighting pediatric cancer.</p>
		<a href={fundraisingData.donorDriveLink} target="_blank" rel="noopener noreferrer" class="donate-button">
			Donate Now
		</a>
	</section>

	<section class="all-time">
		<h2>Our Impact</h2>
		<div class="impact-stat">
			<span class="stat-label">All-Time Fundraising Total</span>
			<span class="stat-amount">{formattedAllTime}</span>
		</div>
	</section>

	<section class="history">
		<h2>Historical Totals</h2>
		<div class="history-grid">
			{fundraisingData.history.map(year => (
				<div class="year-card">
					<span class="year">{year.year}</span>
					<span class="total">
						{year.total.toLocaleString('en-US', { 
							style: 'currency', 
							currency: 'USD',
							minimumFractionDigits: 2,
							maximumFractionDigits: 2
						})}
					</span>
				</div>
			))}
		</div>
	</section>

	<section class="about-four-diamonds">
		<h2>About Four Diamonds</h2>
		<p>Four Diamonds conquers childhood cancer by assisting children treated at Penn State Health Children's Hospital and their families through superior care, comprehensive support, and innovative research.</p>
		<p>Since 1972, Four Diamonds has raised more than $200 million to ensure that no family ever receives a bill from Penn State Health Children's Hospital for cancer treatment. The Fund also supports pediatric cancer research to help find a cure.</p>
	</section>
</PublicLayout>

<style>
	h1 {
		font-size: clamp(2.2rem, 4vw, 3rem);
		color: var(--ink-900);
		margin-bottom: 2rem;
		animation: fade-rise 0.6s ease both;
	}

	section {
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		margin-bottom: 2.5rem;
		animation: fade-rise 0.8s ease both;
	}

	section:nth-child(2) { animation-delay: 0.1s; }
	section:nth-child(3) { animation-delay: 0.2s; }
	section:nth-child(4) { animation-delay: 0.3s; }
	section:nth-child(5) { animation-delay: 0.4s; }

	h2 {
		font-size: clamp(1.5rem, 3vw, 1.8rem);
		color: var(--ink-900);
		margin-bottom: 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--brand-sky);
	}

	p {
		line-height: 1.8;
		color: var(--ink-700);
		margin-bottom: 1rem;
	}

	.current-year {
		text-align: center;
	}

	.total-display {
		background: linear-gradient(160deg, rgba(44, 70, 114, 0.95), rgba(44, 70, 114, 0.8));
		padding: 2.5rem;
		border-radius: 16px;
		margin: 2rem 0;
		box-shadow: 0 8px 24px rgba(44, 70, 114, 0.2);
	}

	.total-display .label {
		display: block;
		color: var(--white);
		font-size: 1.2rem;
		margin-bottom: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		font-weight: 500;
	}

	.total-display .amount {
		display: block;
		color: var(--brand-sky);
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		font-weight: 700;
	}

	.donate-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--brand-sky);
		color: var(--brand-ink);
		padding: 1rem 2.5rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		font-size: 1.15rem;
		letter-spacing: 0.02em;
		transition: all 0.3s ease;
		margin-top: 1.5rem;
		box-shadow: 0 4px 12px rgba(106, 170, 228, 0.3);
	}

	.donate-button:hover {
		background: var(--brand-ink);
		color: var(--white);
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(106, 170, 228, 0.4);
	}

	.all-time {
		background: linear-gradient(160deg, rgba(106, 170, 228, 0.95), rgba(106, 170, 228, 0.8));
		color: var(--white);
		text-align: center;
		border: none;
	}

	.all-time h2 {
		color: var(--white);
		border-bottom-color: rgba(255, 255, 255, 0.3);
	}

	.impact-stat {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.stat-label {
		font-size: 1.3rem;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		font-weight: 500;
	}

	.stat-amount {
		font-size: clamp(2.8rem, 6vw, 4rem);
		font-weight: 700;
		text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.15);
	}

	.history-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
	}

	.year-card {
		background: linear-gradient(135deg, rgba(106, 170, 228, 0.08), rgba(106, 170, 228, 0.03));
		padding: 1.75rem;
		border-radius: 16px;
		text-align: center;
		border: 1px solid var(--border-soft);
		border-left: 4px solid var(--brand-ink);
		transition: all 0.3s ease;
	}

	.year-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
		border-left-color: var(--brand-sky);
	}

	.year-card .year {
		display: block;
		font-size: 1.6rem;
		font-weight: 700;
		color: var(--brand-ink);
		margin-bottom: 0.5rem;
	}

	.year-card .total {
		display: block;
		font-size: 1.25rem;
		color: var(--ink-700);
		font-weight: 600;
	}

	.about-four-diamonds {
		background: linear-gradient(135deg, rgba(44, 70, 114, 0.05), rgba(106, 170, 228, 0.05));
	}

	@keyframes fade-rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		section {
			padding: 1.5rem;
		}

		.total-display {
			padding: 2rem 1.5rem;
		}

		.history-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
