---
import PublicLayout from "../layouts/PublicLayout.astro";
import fundraisingData from "../data/fundraising.json";

export const prerender = true;

const currentTotal = fundraisingData.currentTotal.toLocaleString("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const goalTotal = fundraisingData.goalTotal ?? 0;
const goalTotalFormatted = goalTotal.toLocaleString("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
});
const goalProgress =
  goalTotal > 0 ? Math.min(fundraisingData.currentTotal / goalTotal, 1) : 0;
const goalProgressPercent = Math.round(goalProgress * 100);
const remainingTotal = Math.max(goalTotal - fundraisingData.currentTotal, 0);
const remainingFormatted = remainingTotal.toLocaleString("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
});

const allTimeTotal = fundraisingData.history.reduce(
  (sum, year) => sum + year.total,
  fundraisingData.currentTotal,
);
const formattedAllTime = allTimeTotal.toLocaleString("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
});
---

<PublicLayout title="Fundraising - Mini-THON">
  <h1>Fundraising</h1>

  <section class="current-year">
    <h2>{fundraisingData.currentYear} Fundraising</h2>
    <div class="total-display">
      <span class="label">Current DonorDrive Total</span>
      <span class="amount">{currentTotal}</span>
      <div class="fundraising-progress">
        <div class="progress-header">
          <span class="progress-label">{goalProgressPercent}% to goal</span>
          <span class="progress-value">{currentTotal} raised</span>
        </div>
        <div
          class="progress-slider"
          role="progressbar"
          aria-label="Fundraising progress"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow={goalProgressPercent}
        >
          <div
            class="progress-track"
            style={`--progress: ${goalProgressPercent}%`}
          >
            <div class="progress-fill"></div>
            <div class="progress-thumb"></div>
          </div>
        </div>
        <p class="progress-caption">{remainingFormatted} to reach goal.</p>
      </div>
    </div>
    <p>
      Every dollar raised goes directly to Four Diamonds to support families
      fighting pediatric cancer.
    </p>
    <p>
      Please note that the amount above only refers to donations processed
      through DonorDrive. The yearly grand total will be announced at the end of
      the school year.
    </p>
    <a
      href={fundraisingData.donorDriveLink}
      target="_blank"
      rel="noopener noreferrer"
      class="donate-button"
    >
      Donate Now
    </a>
  </section>

  <section class="all-time">
    <h2>Our Impact</h2>
    <div class="impact-stat">
      <span class="stat-label">All-Time Fundraising Total</span>
      <span class="stat-amount">{formattedAllTime}</span>
    </div>
  </section>

  <section class="history">
    <h2>Historical Totals</h2>
    <ul class="history-list">
      {
        fundraisingData.history.map((year) => (
          <li class="history-item">
            <span class="year">{year.year}</span>
            <span class="total">
              {year.total.toLocaleString("en-US", {
                style: "currency",
                currency: "USD",
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
              })}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <style>
    h1 {
      font-size: clamp(2.2rem, 4vw, 3rem);
      color: var(--ink-900);
      margin-bottom: 2rem;
      animation: fade-rise 0.6s ease both;
    }

    section {
      background: var(--surface-raised);
      padding: 2rem;
      border-radius: 20px;
      box-shadow: var(--shadow-card);
      border: 1px solid var(--border-soft);
      margin-bottom: 2.5rem;
      animation: fade-rise 0.8s ease both;
    }

    section:nth-child(2) {
      animation-delay: 0.1s;
    }
    section:nth-child(3) {
      animation-delay: 0.2s;
    }
    section:nth-child(4) {
      animation-delay: 0.3s;
    }
    section:nth-child(5) {
      animation-delay: 0.4s;
    }

    h2 {
      font-size: clamp(1.5rem, 3vw, 1.8rem);
      color: var(--ink-900);
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid var(--brand-sky);
    }

    p {
      line-height: 1.8;
      color: var(--ink-700);
      margin-bottom: 1rem;
    }

    .current-year {
      text-align: center;
    }

    .total-display {
      background: linear-gradient(
        160deg,
        rgba(44, 70, 114, 0.95),
        rgba(44, 70, 114, 0.8)
      );
      padding: 2.5rem 2.5rem 2rem;
      border-radius: 16px;
      margin: 2rem 0;
      box-shadow: 0 8px 24px rgba(44, 70, 114, 0.2);
      display: grid;
      gap: 1.5rem;
      width: 100%;
      box-sizing: border-box;
    }

    .total-display .label {
      display: block;
      color: var(--white);
      font-size: 1.2rem;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 500;
    }

    .total-display .amount {
      display: block;
      color: var(--brand-sky);
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 700;
    }

    .fundraising-progress {
      display: grid;
      gap: 0.75rem;
      margin: 0;
      width: 100%;
      align-self: stretch;
    }

    .progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.8);
    }

    .progress-label {
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .progress-value {
      font-size: 1.05rem;
      color: var(--white);
    }

    .progress-slider {
      width: 100%;
    }

    .progress-track {
      position: relative;
      height: 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.18);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
      width: 100%;
      --progress: 0%;
    }

    .progress-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: var(--progress);
      background: linear-gradient(
        90deg,
        rgba(106, 170, 228, 0.95),
        rgba(255, 255, 255, 0.85)
      );
      border-radius: 999px;
    }

    .progress-thumb {
      position: absolute;
      top: 50%;
      left: var(--progress);
      transform: translate(-50%, -50%);
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--white);
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
      border: 2px solid rgba(106, 170, 228, 0.8);
    }

    .progress-caption {
      margin: 0;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .donate-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--brand-sky);
      color: var(--brand-ink);
      padding: 1rem 2.5rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      font-size: 1.15rem;
      letter-spacing: 0.02em;
      transition: all 0.3s ease;
      margin-top: 1.5rem;
      box-shadow: 0 4px 12px rgba(106, 170, 228, 0.3);
    }

    .donate-button:hover {
      background: var(--brand-ink);
      color: var(--white);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(106, 170, 228, 0.4);
    }

    .all-time {
      background: linear-gradient(
        160deg,
        rgba(106, 170, 228, 0.95),
        rgba(106, 170, 228, 0.8)
      );
      color: var(--white);
      text-align: center;
      border: none;
    }

    .all-time h2 {
      color: var(--white);
      border-bottom-color: rgba(255, 255, 255, 0.3);
    }

    .impact-stat {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .stat-label {
      font-size: 1.3rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 500;
    }

    .stat-amount {
      font-size: clamp(2.8rem, 6vw, 4rem);
      font-weight: 700;
      text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.15);
    }

    .history-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 1rem;
    }

    .history-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(
        135deg,
        rgba(106, 170, 228, 0.08),
        rgba(106, 170, 228, 0.03)
      );
      padding: 1.25rem 1.5rem;
      border-radius: 16px;
      border: 1px solid var(--border-soft);
    }

    .history-item .year {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--brand-ink);
    }

    .history-item .total {
      font-size: 1.2rem;
      color: var(--ink-700);
      font-weight: 600;
    }

    @keyframes fade-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 768px) {
      section {
        padding: 1.5rem;
      }

      .total-display {
        padding: 2rem 1.5rem;
      }

      .fundraising-progress {
        max-width: none;
        padding: 1.25rem;
      }

      .progress-header {
        flex-wrap: wrap;
        gap: 0.35rem 1rem;
      }

      .progress-track {
        height: 12px;
      }

      .fundraising-progress {
        padding: 1.25rem 1rem;
        box-sizing: border-box;
      }

      .progress-thumb {
        width: 18px;
        height: 18px;
      }

      .history-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.35rem;
      }
    }
  </style>
</PublicLayout>
