---
import PublicLayout from '../layouts/PublicLayout.astro';
import clubInfo from '../data/clubInfo.json';
import fundraisingData from '../data/fundraising.json';

export const prerender = true;
---

<PublicLayout title="Get Involved - Mini-THON">
	<h1>Get Involved</h1>
	
	<section class="intro">
		<p>There are many ways to support Mini-THON and help us fight pediatric cancer. Whether you're a student, business owner, or parent, you can make a difference!</p>
	</section>

	<section id="students" class="audience-section">
		<h2>For Students</h2>
		<div class="content-card">
			<h3>Join Our Club!</h3>
			<p class="gmhs-note"><strong>Open to GMHS Students Only</strong></p>
			<p><strong>When:</strong> {clubInfo.meetings.general}</p>
			<p>No experience needed! We welcome all GMHS students who want to make a difference in the lives of children fighting cancer.</p>
			
			<h3>What We Do</h3>
			<ul>
				<li>Organize fundraising events throughout the year</li>
				<li>Raise awareness about pediatric cancer</li>
				<li>Build leadership and teamwork skills</li>
				<li>Make lasting friendships while helping others</li>
			</ul>

			<h3>Stay Connected</h3>
			<div class="social-links">
				<a href={clubInfo.socialMedia.instagram} target="_blank" rel="noopener noreferrer" class="button instagram">
					Follow on Instagram
				</a>
				<div class="groupme-info">
					<p><strong>GroupMe:</strong> {clubInfo.socialMedia.groupme}</p>
					<p class="code">Join Code: {clubInfo.socialMedia.groupmeCode}</p>
				</div>
			</div>
		</div>
	</section>

	<section id="businesses" class="audience-section">
		<h2>For Businesses</h2>
		<div class="content-card">
			<h3>Become a Sponsor</h3>
			<p>Support our mission and gain visibility in the community! We offer three sponsorship tiers:</p>
			
			<div class="tiers">
				<div class="tier gold">
					<h4>Gold Sponsor</h4>
					<ul>
						<li>Logo on event materials</li>
						<li>Social media recognition</li>
						<li>Premium placement on website</li>
						<li>Recognition at main event</li>
					</ul>
				</div>
				<div class="tier silver">
					<h4>Silver Sponsor</h4>
					<ul>
						<li>Logo on website</li>
						<li>Social media shoutout</li>
						<li>Recognition at events</li>
					</ul>
				</div>
				<div class="tier bronze">
					<h4>Bronze Sponsor</h4>
					<ul>
						<li>Name on website</li>
						<li>Social media mention</li>
					</ul>
				</div>
			</div>

			<h3>Interested in Sponsoring?</h3>
			<p>Contact us to learn more about sponsorship opportunities and how your business can help fight pediatric cancer.</p>
			<a href={`mailto:${clubInfo.contact.email}?subject=Sponsorship Inquiry`} class="button">Contact Us About Sponsorship</a>
		</div>
	</section>

	<section id="parents" class="audience-section">
		<h2>For Parents & Community Members</h2>
		<div class="content-card">
			<h3>Make a Donation</h3>
			<p>Every dollar you donate goes directly to Four Diamonds and Penn State Hershey Children's Hospital to support families fighting pediatric cancer.</p>
			
			<a href={fundraisingData.donorDriveLink} target="_blank" rel="noopener noreferrer" class="button donate">
				Donate via DonorDrive
			</a>

			<h3>Attend Our Events</h3>
			<p>Support our fundraising events throughout the year! Check out our <a href="/events">Events page</a> to see what's coming up.</p>

			<h3>Questions?</h3>
			<p>Contact us at <a href={`mailto:${clubInfo.contact.email}`}>{clubInfo.contact.email}</a> or call {clubInfo.contact.phone}</p>
		</div>
	</section>
</PublicLayout>

<style>
	h1 {
		font-size: clamp(2.2rem, 4vw, 3rem);
		color: var(--ink-900);
		margin-bottom: 2rem;
		animation: fade-rise 0.6s ease both;
	}

	section {
		margin-bottom: 3rem;
		animation: fade-rise 0.8s ease both;
	}

	section:nth-child(2) { animation-delay: 0.1s; }
	section:nth-child(3) { animation-delay: 0.2s; }
	section:nth-child(4) { animation-delay: 0.3s; }
	section:nth-child(5) { animation-delay: 0.4s; }

	.intro {
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--ink-700);
	}

	.audience-section h2 {
		font-size: clamp(1.6rem, 3vw, 2rem);
		color: var(--ink-900);
		margin-bottom: 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--brand-sky);
	}

	.content-card {
		background: var(--surface-raised);
		padding: 2rem;
		border-radius: 20px;
		box-shadow: var(--shadow-card);
		border: 1px solid var(--border-soft);
	}

	.content-card h3 {
		color: var(--brand-ink);
		font-size: 1.4rem;
		margin-top: 2rem;
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.content-card h3:first-child {
		margin-top: 0;
	}

	.content-card p {
		line-height: 1.8;
		margin-bottom: 1rem;
		color: var(--ink-700);
	}

	.gmhs-note {
		background: linear-gradient(135deg, rgba(106, 170, 228, 0.15), rgba(106, 170, 228, 0.08));
		padding: 0.75rem 1.25rem;
		border-radius: 12px;
		border-left: 4px solid var(--brand-sky);
		font-size: 1rem;
		color: var(--brand-ink) !important;
		margin: 1rem 0;
	}

	.content-card ul {
		margin-left: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.content-card li {
		margin-bottom: 0.75rem;
		line-height: 1.6;
		color: var(--ink-700);
	}

	.content-card a {
		color: var(--brand-ink);
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.content-card a:hover {
		color: var(--brand-sky);
	}

	.social-links {
		display: flex;
		gap: 2rem;
		align-items: flex-start;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.groupme-info {
		background: linear-gradient(135deg, rgba(106, 170, 228, 0.08), rgba(106, 170, 228, 0.03));
		padding: 1.25rem;
		border-radius: 12px;
		border: 1px solid var(--border-soft);
		flex: 1;
		min-width: 250px;
	}

	.groupme-info p {
		margin: 0.5rem 0;
		color: var(--ink-700);
	}

	.groupme-info .code {
		font-family: 'Courier New', monospace;
		font-weight: 600;
		color: var(--brand-ink);
		background: var(--white);
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		display: inline-block;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.9rem 1.8rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		letter-spacing: 0.02em;
		transition: all 0.3s ease;
		margin-top: 1rem;
		margin-right: 1rem;
	}

	.button.instagram {
		background: linear-gradient(135deg, #833AB4 0%, #E1306C 50%, #FD1D1D 100%);
		color: var(--white);
		box-shadow: 0 4px 12px rgba(131, 58, 180, 0.3);
	}

	.button.instagram:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(131, 58, 180, 0.4);
	}

	.button.donate {
		background: var(--brand-sky);
		color: var(--brand-ink);
		font-size: 1.1rem;
		box-shadow: 0 4px 12px rgba(106, 170, 228, 0.3);
	}

	.button.donate:hover {
		background: var(--brand-ink);
		color: var(--white);
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(106, 170, 228, 0.4);
	}

	.button:not(.instagram):not(.donate) {
		background: var(--brand-ink);
		color: var(--white);
		box-shadow: 0 4px 12px rgba(44, 70, 114, 0.3);
	}

	.button:not(.instagram):not(.donate):hover {
		background: var(--brand-sky);
		color: var(--brand-ink);
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(44, 70, 114, 0.4);
	}

	.tiers {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
		margin: 2rem 0;
	}

	.tier {
		padding: 1.75rem;
		border-radius: 16px;
		border: 2px solid;
		transition: all 0.3s ease;
	}

	.tier:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
	}

	.tier.gold {
		border-color: #D4AF37;
		background: linear-gradient(135deg, rgba(212, 175, 55, 0.12), rgba(212, 175, 55, 0.05));
	}

	.tier.silver {
		border-color: #9AA0A6;
		background: linear-gradient(135deg, rgba(154, 160, 166, 0.12), rgba(154, 160, 166, 0.05));
	}

	.tier.bronze {
		border-color: #CD7F32;
		background: linear-gradient(135deg, rgba(205, 127, 50, 0.12), rgba(205, 127, 50, 0.05));
	}

	.tier h4 {
		margin-bottom: 1.25rem;
		font-size: 1.35rem;
		font-weight: 600;
	}

	.tier.gold h4 {
		color: #B8860B;
	}

	.tier.silver h4 {
		color: #708090;
	}

	.tier.bronze h4 {
		color: #8B4513;
	}

	.tier ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.tier li {
		padding: 0.6rem 0;
		padding-left: 1.8rem;
		position: relative;
		color: var(--ink-700);
	}

	.tier li::before {
		content: "✓";
		position: absolute;
		left: 0;
		font-weight: bold;
		color: #4CAF50;
		font-size: 1.1rem;
	}

	@keyframes fade-rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		.content-card {
			padding: 1.5rem;
		}

		.tiers {
			grid-template-columns: 1fr;
		}

		.social-links {
			flex-direction: column;
			gap: 1rem;
		}

		.groupme-info {
			min-width: 100%;
		}
	}
</style>
