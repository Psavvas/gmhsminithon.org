---
import clubInfo from "../data/clubInfo.json";
---

<!-- Social Popup Modal -->
<div
  id="social-popup"
  class="social-popup-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="social-popup-title"
  hidden
>
  <div class="social-popup-card">
    <div class="social-popup-header">
      <h2 id="social-popup-title">Find Us Online</h2>
      <button
        class="social-popup-close"
        aria-label="Close"
        id="social-popup-close"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <p class="social-popup-desc">
      Follow us on social media for the latest updates, highlights, and event
      news.
    </p>

    <div class="social-links-grid">
      <a
        href={clubInfo.socialMedia.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="social-link instagram"
      >
        <span class="social-icon-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"
            ></circle>
          </svg>
        </span>
        <span class="social-label">
          <span class="social-name">Instagram</span>
          <span class="social-handle">@gmhsminithon</span>
        </span>
        <svg
          class="social-arrow"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a
        href={clubInfo.socialMedia.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="social-link facebook"
      >
        <span class="social-icon-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M22.675 0h-21.35C.595 0 0 .592 0 1.326v21.348C0 23.408.595 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.797.143v3.24l-1.918.001c-1.504 0-1.797.715-1.797 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.406 24 24 23.408 24 22.674V1.326C24 .592 23.406 0 22.675 0"
            ></path>
          </svg>
        </span>
        <span class="social-label">
          <span class="social-name">Facebook</span>
          <span class="social-handle">@gmhsftk</span>
        </span>
        <svg
          class="social-arrow"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a
        href={clubInfo.socialMedia.tiktok}
        target="_blank"
        rel="noopener noreferrer"
        class="social-link tiktok"
      >
        <span class="social-icon-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M12.525.02c1.31-.02 2.61-.01 3.91 0 .08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.67 1.69 4.2 1.77v4.03c-1.43-.04-2.86-.35-4.18-.89-.57-.24-1.1-.53-1.62-.85-.01 2.92.02 5.84-.02 8.75-.08 1.4-.54 2.78-1.35 3.92-1.31 1.92-3.58 3.17-5.91 3.29-1.43.08-2.86-.15-4.17-.72-2.12-.92-3.74-2.8-4.47-5-.25-.72-.38-1.48-.43-2.24v-.97c.02-.17.05-.34.07-.51.18-1.21.66-2.37 1.37-3.35 1.01-1.41 2.48-2.48 4.13-3.02 1.07-.35 2.22-.43 3.34-.31.02 1.48-.04 2.96-.04 4.44-.75-.24-1.56-.3-2.33-.14-.53.12-1.03.37-1.44.73a3.16 3.16 0 0 0-1 1.63c-.09.39-.12.79-.08 1.19.17 1.6 1.5 3.05 3.1 3.27 1.06.16 2.14-.09 3-.73.86-.62 1.45-1.62 1.62-2.68.11-.66.07-1.32.08-1.98.01-3.2-.01-6.4.02-9.6z"
            ></path>
          </svg>
        </span>
        <span class="social-label">
          <span class="social-name">TikTok</span>
          <span class="social-handle">@gmhs.minithon</span>
        </span>
        <svg
          class="social-arrow"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="newsletter-section">
      <div class="newsletter-inner">
        <div class="newsletter-content">
          <h3>Newsletter</h3>
          <p>Subscribe to get event updates delivered to your inbox.</p>
          <form class="popup-newsletter-form" id="popup-newsletter-form" novalidate>
            <div class="popup-newsletter-row">
              <label for="popup-newsletter-email" class="sr-only">Email address</label>
              <input
                id="popup-newsletter-email"
                name="email"
                type="email"
                placeholder="Your email address"
                required
                autocomplete="email"
              />
              <button type="submit">Subscribe</button>
            </div>
            <p class="popup-newsletter-status" id="popup-newsletter-status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const overlay = document.getElementById("social-popup");
  const closeBtn = document.getElementById("social-popup-close");
  const triggers = document.querySelectorAll("[data-open-social-popup]");
  let closeFallbackTimer;

  // Move popup to <body> root so it escapes any parent stacking contexts (e.g. <main> z-index)
  if (
    overlay &&
    overlay.parentElement !== document.body &&
    !overlay.dataset.relocated
  ) {
    overlay.dataset.relocated = "true";
    document.body.appendChild(overlay);
  }

  function openPopup() {
    if (!overlay) return;
    overlay.hidden = false;
    overlay.classList.remove("is-open");
    requestAnimationFrame(() => {
      overlay.classList.add("is-open");
    });
    closeBtn?.focus();
  }

  function closePopup() {
    if (!overlay) return;
    clearTimeout(closeFallbackTimer);
    overlay.classList.remove("is-open");
    const finishClose = () => {
      overlay.hidden = true;
    };
    overlay.addEventListener("transitionend", finishClose, { once: true });
    closeFallbackTimer = setTimeout(finishClose, 300);
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", (e) => {
      e.preventDefault();
      openPopup();
    });
  });

  closeBtn?.addEventListener("click", closePopup);

  overlay?.addEventListener("click", (e) => {
    if (e.target === overlay) closePopup();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay && !overlay.hidden) {
      closePopup();
    }
  });

  const popupNewsletterForm = document.getElementById(
    "popup-newsletter-form",
  ) as HTMLFormElement | null;
  const popupNewsletterStatus = document.getElementById(
    "popup-newsletter-status",
  );

  if (popupNewsletterForm && popupNewsletterStatus) {
    popupNewsletterForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = popupNewsletterForm.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      if (button) button.disabled = true;
      popupNewsletterStatus.textContent = "";
      popupNewsletterStatus.className = "popup-newsletter-status";

      try {
        const emailInput = popupNewsletterForm.querySelector(
          'input[name="email"]',
        ) as HTMLInputElement | null;
        const email = emailInput?.value?.trim() ?? "";
        const res = await fetch("/api/newsletter", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ email }),
        });
        const raw = await res.text();
        let json: {
          success?: boolean;
          error?: string;
        } = {};

        try {
          json = (raw ? JSON.parse(raw) : {}) as {
            success?: boolean;
            error?: string;
          };
        } catch {
          json = {
            error:
              raw.trim() ||
              `Subscription failed (${res.status}). Please try again later.`,
          };
        }

        if (json.success) {
          popupNewsletterStatus.textContent = "Subscribed successfully.";
          popupNewsletterStatus.classList.add(
            "popup-newsletter-status--success",
          );
          popupNewsletterForm.reset();
        } else {
          popupNewsletterStatus.textContent =
            json.error ??
            `Subscription failed (${res.status}). Please try again.`;
          popupNewsletterStatus.classList.add("popup-newsletter-status--error");
        }
      } catch {
        popupNewsletterStatus.textContent =
          "Unable to subscribe right now. Please try again later.";
        popupNewsletterStatus.classList.add("popup-newsletter-status--error");
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>

<style>
  .social-popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(12, 20, 35, 0.6);
    backdrop-filter: blur(4px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .social-popup-overlay.is-open {
    opacity: 1;
  }

  .social-popup-overlay[hidden] {
    display: none;
  }

  .social-popup-card {
    background: #fff;
    border-radius: 24px;
    padding: 2rem;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 24px 60px rgba(28, 42, 58, 0.22);
    transform: translateY(20px) scale(0.97);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
    opacity: 0;
    max-height: 90vh;
    overflow-y: auto;
  }

  .social-popup-overlay.is-open .social-popup-card {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .social-popup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    gap: 1rem;
  }

  .social-popup-header h2 {
    font-family: "Merriweather", "Times New Roman", serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #1c2a3a;
    margin: 0;
  }

  .social-popup-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: #f4f7fb;
    color: #3d4c5c;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .social-popup-close:hover {
    background: #d7e2ef;
    color: #1c2a3a;
  }

  .social-popup-close svg {
    width: 16px;
    height: 16px;
  }

  .social-popup-desc {
    font-size: 0.93rem;
    color: #6a7a8a;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .social-links-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    border: 1.5px solid #d7e2ef;
    background: #f4f7fb;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--link-color, #6aaae4);
    background: var(--link-bg, rgba(106, 170, 228, 0.07));
    box-shadow: 0 4px 14px rgba(28, 42, 58, 0.08);
    transform: translateY(-1px);
  }

  .social-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--link-icon-bg, #e8eff7);
    color: var(--link-icon-color, #2c4672);
    flex-shrink: 0;
  }

  .social-icon-wrap svg {
    width: 20px;
    height: 20px;
  }

  .social-label {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
  }

  .social-name {
    font-weight: 600;
    font-size: 0.97rem;
    color: #1c2a3a;
  }

  .social-handle {
    font-size: 0.82rem;
    color: #6a7a8a;
  }

  .social-arrow {
    width: 16px;
    height: 16px;
    color: #9aa8b6;
    flex-shrink: 0;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .social-link:hover .social-arrow {
    color: var(--link-color, #6aaae4);
    transform: translateX(3px);
  }

  /* Platform-specific colours */
  .instagram {
    --link-color: #e1306c;
    --link-bg: rgba(225, 48, 108, 0.05);
    --link-icon-bg: rgba(225, 48, 108, 0.1);
    --link-icon-color: #e1306c;
  }

  .facebook {
    --link-color: #1877f2;
    --link-bg: rgba(24, 119, 242, 0.05);
    --link-icon-bg: rgba(24, 119, 242, 0.1);
    --link-icon-color: #1877f2;
  }

  .tiktok {
    --link-color: #010101;
    --link-bg: rgba(1, 1, 1, 0.04);
    --link-icon-bg: rgba(1, 1, 1, 0.07);
    --link-icon-color: #010101;
  }

  /* Newsletter coming soon */
  .newsletter-section {
    border-top: 1px solid #d7e2ef;
    padding-top: 1.25rem;
  }

  .newsletter-inner {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
  }

  .newsletter-content {
    padding: 1.25rem;
    background: #f4f7fb;
    border-radius: 14px;
  }

  .newsletter-content h3 {
    font-family: "Merriweather", "Times New Roman", serif;
    font-size: 1rem;
    font-weight: 700;
    color: #1c2a3a;
    margin: 0 0 0.35rem;
  }

  .newsletter-content p {
    font-size: 0.85rem;
    color: #6a7a8a;
    margin: 0 0 0.85rem;
    line-height: 1.5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .popup-newsletter-row {
    display: flex;
    gap: 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #d7e2ef;
  }

  .popup-newsletter-row input {
    flex: 1;
    padding: 0.55rem 0.9rem;
    background: #fff;
    border: none;
    font-size: 0.85rem;
    color: #1c2a3a;
    outline: none;
    min-width: 0;
  }

  .popup-newsletter-row button {
    padding: 0.55rem 1rem;
    background: #2c4672;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .popup-newsletter-status {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    min-height: 1.2em;
    color: #6a7a8a;
  }

  .popup-newsletter-status--success {
    color: #166534;
  }

  .popup-newsletter-status--error {
    color: #b91c1c;
  }

  @media (max-width: 480px) {
    .social-popup-card {
      padding: 1.5rem;
    }

    .social-popup-header h2 {
      font-size: 1.2rem;
    }
  }
</style>
