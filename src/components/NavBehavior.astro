      pointer-events: auto;
    }

    :global(.navbar.nav-open .nav-toggle-bar:nth-child(1)) {
      transform: translateY(6px) rotate(45deg);
    }

    :global(.navbar.nav-open .nav-toggle-bar:nth-child(2)) {
      opacity: 0;
    }

    :global(.navbar.nav-open .nav-toggle-bar:nth-child(3)) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }

  @media (max-width: 480px) {
    :global(.nav-links) {
      padding: 5rem 1rem 2rem;
      gap: 1rem;
    }

    :global(.nav-links a) {
      font-size: 1rem;
      padding: 0.7rem 1rem;
    }
  }
</style>
