        visibility 0.3s ease;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    :global(.nav-links li) {
      width: min(100%, 28rem);
    }

    /* Ensure form wrappers (e.g. logout button) also fill the list item */
    :global(.nav-links li form) {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    :global(.nav-links a) {
      display: flex;
