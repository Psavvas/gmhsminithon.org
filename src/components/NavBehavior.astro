<script>
  const navbarAnimationStorageKey = "gmhs-navbar-animated";
  const animationState = window as Window & { __gmhsNavbarAnimated?: boolean };
  const canIgnoreStorageError = (error: unknown) =>
    error instanceof DOMException &&
    ["QuotaExceededError", "SecurityError"].includes(error.name);
  const navbar = document.querySelector<HTMLElement>(".navbar");
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const navLinks = document.querySelector<HTMLUListElement>(".nav-links");

  if (navbar) {
    const hasAnimatedInMemory = animationState.__gmhsNavbarAnimated === true;
    let hasAnimatedInStorage = false;
    if (!hasAnimatedInMemory) {
      try {
        hasAnimatedInStorage =
          sessionStorage.getItem(navbarAnimationStorageKey) === "true";
      } catch (error) {
        if (!canIgnoreStorageError(error)) throw error;
      }
    }
    const hasAnimated = hasAnimatedInMemory || hasAnimatedInStorage;

    if (hasAnimated) {
      navbar.style.animation = "none";
    } else {
      animationState.__gmhsNavbarAnimated = true;
      try {
        sessionStorage.setItem(navbarAnimationStorageKey, "true");
      } catch (error) {
        if (!canIgnoreStorageError(error)) throw error;
      }

      navbar.addEventListener(
        "animationend",
        () => {
          navbar.style.animation = "none";
        },
        { once: true },
      );
    }

    let lastScrollY = window.scrollY;
    const hideOffset = 80;
    const scrollThreshold = 10;
    const setNavOffset = () => {
      document.documentElement.style.setProperty(
        "--nav-offset",
        `${navbar.offsetHeight}px`,
      );
    };

    setNavOffset();
    window.addEventListener("resize", setNavOffset);

    if ("ResizeObserver" in window) {
      const observer = new ResizeObserver(() => {
        setNavOffset();
      });
      observer.observe(navbar);
    }

    if (toggle && navLinks) {
      toggle.addEventListener("click", () => {
        const isOpen = navbar.classList.toggle("nav-open");
        toggle.setAttribute("aria-expanded", String(isOpen));
        navbar.classList.remove("is-hidden");
        document.body.classList.remove("nav-hidden");
      });

      navLinks.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          navbar.classList.remove("nav-open");
          toggle.setAttribute("aria-expanded", "false");
        });
      });
    }

    window.addEventListener(
      "scroll",
      () => {
        const currentY = window.scrollY;
        const delta = currentY - lastScrollY;

        if (!navbar.classList.contains("nav-open")) {
          if (delta > scrollThreshold && currentY > hideOffset) {
            navbar.classList.add("is-hidden");
            document.body.classList.add("nav-hidden");
          }

          if (delta < -scrollThreshold || currentY <= hideOffset) {
            navbar.classList.remove("is-hidden");
            document.body.classList.remove("nav-hidden");
          }
        }

        lastScrollY = currentY;
      },
      { passive: true },
    );
  }
</script>

