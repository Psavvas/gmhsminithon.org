          rgba(44, 70, 114, 0.98),
          rgba(106, 170, 228, 0.95)
        )
      );
      backdrop-filter: blur(20px);
      opacity: 0;
      transform: scale(0.98);
      visibility: hidden;
      pointer-events: none;
      z-index: 1001;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
      transition:
        opacity 0.3s ease,
