---
import Analytics from '@vercel/analytics/astro';
import NavBehavior from '../components/NavBehavior.astro';

export interface Props {
	title: string;
	description?: string;
}

const { title, description = "Mini-THON - Fighting Pediatric Cancer" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Merriweather:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/masthead-diamond-blue.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<Analytics />
	</head>
	<body>
		<nav class="navbar">
			<div class="nav-container">
				<a href="/" class="logo">
					<img class="logo-gmhs" src="/gmhs-logo.png" alt="Great Mills High School" loading="eager" />
					<span class="logo-divider" aria-hidden="true"></span>
					<img class="logo-diamond" src="/masthead-diamond-white.svg" alt="Mini-THON diamond" loading="eager" />
					<span class="logo-text">
						<span class="logo-text-school">GMHS</span>
						<span class="logo-text-event">Mini-THON</span>
					</span>
				</a>
				<button class="nav-toggle" type="button" aria-controls="primary-nav" aria-expanded="false">
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>
				<ul class="nav-links" id="primary-nav">
					<li><a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a></li>
					<li><a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a></li>
					<li><a href="/sponsors" class={currentPath === '/sponsors' ? 'active' : ''}>Sponsors</a></li>
					<li><a href="/get-involved" class={currentPath === '/get-involved' ? 'active' : ''}>Get Involved</a></li>
					<li><a href="/events" class={currentPath === '/events' ? 'active' : ''}>Events</a></li>
					<li><a href="/fundraising" class={currentPath === '/fundraising' ? 'active' : ''}>Fundraising</a></li>
					<li>
						<button type="button" class="nav-subscribe-btn" data-open-newsletter aria-label="Subscribe to newsletter">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
								<rect x="2" y="4" width="20" height="16" rx="3"/>
								<polyline points="2,4 12,13 22,4"/>
							</svg>
							<span>Subscribe</span>
						</button>
					</li>
					<li><a href="/members/login" class="member-login">Member Login</a></li>
				</ul>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-container">
				<div class="footer-grid">
					<!-- Brand column -->
					<div class="footer-brand">
						<a href="/" class="footer-logo">
							<img src="/gmhs-logo.png" alt="Great Mills High School" class="footer-logo-gmhs" />
							<span class="footer-logo-divider" aria-hidden="true"></span>
							<img src="/masthead-diamond-white.svg" alt="Mini-THON diamond" class="footer-logo-diamond" />
							<span class="footer-logo-text">
								<span class="footer-logo-school">GMHS</span>
								<span class="footer-logo-event">Mini-THON</span>
							</span>
						</a>
						<p class="footer-description">
							A student-driven charitable organization at Great Mills High School dedicated to raising funds and awareness for pediatric cancer through Four Diamonds.
						</p>
						<div class="footer-social">
							<a href="https://instagram.com/gmhsminithon" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Follow us on Instagram">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
									<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
									<circle cx="12" cy="12" r="4"/>
									<circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
								</svg>
								<span>Instagram</span>
							</a>
							<a href="https://fourdiamonds.donordrive.com/GMHSMT" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Donate on DonorDrive">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
									<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
								</svg>
								<span>DonorDrive</span>
							</a>
						</div>
					</div>

					<!-- Navigation column -->
					<div class="footer-nav">
						<h3 class="footer-heading">Quick Links</h3>
						<ul>
							<li><a href="/">Home</a></li>
							<li><a href="/about">About</a></li>
							<li><a href="/sponsors">Sponsors</a></li>
							<li><a href="/get-involved">Get Involved</a></li>
							<li><a href="/events">Events</a></li>
							<li><a href="/fundraising">Fundraising</a></li>
						</ul>
					</div>

					<!-- Newsletter column -->
					<div class="footer-newsletter">
						<h3 class="footer-heading">Stay Updated</h3>
						<p class="footer-newsletter-desc">Subscribe to our newsletter and never miss an event or update.</p>
						<form class="newsletter-form" id="newsletter-form" novalidate>
							<div class="newsletter-input-row">
								<label for="newsletter-email" class="sr-only">Email address</label>
								<input
									type="email"
									id="newsletter-email"
									name="email"
									placeholder="Your email address"
									required
									autocomplete="email"
								/>
								<button type="submit">Subscribe</button>
							</div>
							<p class="newsletter-status" id="newsletter-status" aria-live="polite"></p>
						</form>
					</div>
				</div>

				<div class="footer-bottom">
					<p class="footer-copyright">&copy; {new Date().getFullYear()} Great Mills High School Mini-THON. All rights reserved.</p>
					<p class="footer-legal">Mini-THON® and Four Diamonds Mini-THON® are registered trademarks. The Diamond Masthead and DonorDrive® are owned by their respective trademark holders. Used with permission.</p>
				</div>
			</div>
		</footer>

		<dialog id="newsletter-modal" aria-labelledby="newsletter-modal-title">
			<div class="modal-inner">
				<div class="modal-header">
					<h2 id="newsletter-modal-title">Stay Updated</h2>
					<button id="newsletter-modal-close" type="button" aria-label="Close">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" focusable="false">
							<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
						</svg>
					</button>
				</div>
				<p class="modal-desc">Subscribe to our newsletter and never miss an event, fundraising milestone, or update in our fight against pediatric cancer.</p>
				<form id="newsletter-modal-form" novalidate>
					<div class="modal-input-row">
						<label for="newsletter-modal-email" class="sr-only">Email address</label>
						<input
							type="email"
							id="newsletter-modal-email"
							name="email"
							placeholder="Your email address"
							required
							autocomplete="email"
						/>
						<button type="submit">Subscribe</button>
					</div>
					<p class="newsletter-status" id="newsletter-modal-status" aria-live="polite"></p>
				</form>
			</div>
		</dialog>

		<script>
			async function submitNewsletterForm(
				email: string,
				statusEl: HTMLElement,
				form: HTMLFormElement,
				button: HTMLButtonElement | null
			) {
				if (button) button.disabled = true;
				statusEl.textContent = '';
				statusEl.className = 'newsletter-status';
				try {
					const fd = new FormData();
					fd.set('email', email);
					const res = await fetch('/api/newsletter', { method: 'POST', body: fd });
					const json = await res.json() as { success?: boolean; error?: string };
					if (json.success) {
						statusEl.textContent = "✓ You're subscribed! Thank you.";
						statusEl.classList.add('newsletter-status--success');
						form.reset();
					} else {
						statusEl.textContent = json.error ?? 'Something went wrong. Please try again.';
						statusEl.classList.add('newsletter-status--error');
					}
				} catch {
					statusEl.textContent = 'Unable to subscribe right now. Please try again later.';
					statusEl.classList.add('newsletter-status--error');
				} finally {
					if (button) button.disabled = false;
				}
			}

			// Footer form
			const footerForm = document.getElementById('newsletter-form') as HTMLFormElement | null;
			const footerStatus = document.getElementById('newsletter-status');
			if (footerForm && footerStatus) {
				footerForm.addEventListener('submit', async (e) => {
					e.preventDefault();
					const emailInput = footerForm.querySelector('input[name="email"]') as HTMLInputElement | null;
					const button = footerForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
					await submitNewsletterForm(emailInput?.value ?? '', footerStatus, footerForm, button);
				});
			}

			// Modal form
			const modal = document.getElementById('newsletter-modal') as HTMLDialogElement | null;
			const modalForm = document.getElementById('newsletter-modal-form') as HTMLFormElement | null;
			const modalStatus = document.getElementById('newsletter-modal-status');
			const modalClose = document.getElementById('newsletter-modal-close');

			document.querySelectorAll('[data-open-newsletter]').forEach((el) => {
				el.addEventListener('click', () => {
					if (modal) modal.showModal();
				});
			});

			modalClose?.addEventListener('click', () => modal?.close());

			modal?.addEventListener('click', (e) => {
				if (e.target === modal) modal?.close();
			});

			modal?.addEventListener('close', () => {
				if (modalStatus) {
					modalStatus.textContent = '';
					modalStatus.className = 'newsletter-status';
				}
			});

			if (modalForm && modalStatus) {
				modalForm.addEventListener('submit', async (e) => {
					e.preventDefault();
					const emailInput = modalForm.querySelector('input[name="email"]') as HTMLInputElement | null;
					const button = modalForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
					await submitNewsletterForm(emailInput?.value ?? '', modalStatus, modalForm, button);
				});
			}
		</script>
		<NavBehavior />
	</body>
</html>

<style>
	:root {
		--brand-ink: #2C4672;
		--brand-sky: #6AAAE4;
		--ink-900: #1C2A3A;
		--ink-700: #3D4C5C;
		--ink-500: #6A7A8A;
		--surface: #F4F7FB;
		--surface-raised: #FFFFFF;
		--border-soft: #D7E2EF;
		--white: #FFFFFF;
		--shadow-soft: 0 18px 45px rgba(28, 42, 58, 0.12);
		--shadow-card: 0 12px 30px rgba(28, 42, 58, 0.08);
		--nav-overlay: linear-gradient(135deg, rgba(44, 70, 114, 0.98), rgba(106, 170, 228, 0.95));
		--nav-offset: 84px;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: 'Montserrat', 'Helvetica Neue', 'Noto Sans', sans-serif;
		background-color: var(--surface);
		color: var(--ink-900);
		overflow-x: hidden;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		position: relative;
		background: radial-gradient(circle at 10% 10%, rgba(106, 170, 228, 0.18), transparent 45%),
			linear-gradient(140deg, rgba(44, 70, 114, 0.05), transparent 35%),
			var(--surface);
		overflow-x: hidden;
		padding-top: 0;
	}

	body.nav-hidden {
		padding-top: 0;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.08), rgba(106, 170, 228, 0.06));
		pointer-events: none;
		z-index: 0;
	}

	main,
	.navbar,
	footer {
		position: relative;
		z-index: 1;
	}

	:global(h1),
	:global(h2),
	:global(h3) {
		font-family: 'Merriweather', 'Times New Roman', serif;
		letter-spacing: 0.01em;
		color: var(--ink-900);
	}

	@keyframes nav-enter {
		from {
			transform: translateY(-100%);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	.navbar {
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.98), rgba(44, 70, 114, 0.92));
		color: var(--white);
		padding: 1rem 0;
		box-shadow: 0 4px 20px rgba(28, 42, 58, 0.15);
		backdrop-filter: blur(14px);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
		animation: nav-enter 0.3s ease-out both;
	}

	@media (prefers-reduced-motion: reduce) {
		.navbar {
			animation: none;
		}
	}

	.navbar.is-hidden {
		transform: translateY(-100%);
		box-shadow: none;
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--white);
		text-decoration: none;
		flex-shrink: 0;
	}

	.logo-gmhs {
		height: 34px;
		width: auto;
		object-fit: contain;
		display: block;
		flex-shrink: 0;
	}

	.logo-divider {
		width: 1px;
		height: 26px;
		background: rgba(255, 255, 255, 0.3);
		flex-shrink: 0;
	}

	.logo-diamond {
		height: 30px;
		width: auto;
		object-fit: contain;
		display: block;
		flex-shrink: 0;
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.logo-text-school {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}

	.logo-text-event {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--white);
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 1.25rem;
		align-items: center;
	}

	.nav-links a {
		color: var(--white);
		text-decoration: none;
		transition: all 0.3s ease;
		padding: 0.5rem 0;
		border-bottom: 2px solid transparent;
		font-weight: 500;
		font-size: 0.95rem;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--brand-sky);
		border-bottom-color: var(--brand-sky);
	}

	.member-login {
		background: var(--brand-sky);
		padding: 0.45rem 1.1rem !important;
		border-radius: 999px;
		font-weight: 600;
		letter-spacing: 0.02em;
		border-bottom: 2px solid transparent !important;
		transition: all 0.3s ease;
	}

	.member-login:hover {
		background-color: var(--white);
		color: var(--brand-ink) !important;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(106, 170, 228, 0.3);
	}

	main {
		flex: 1;
		max-width: 1160px;
		margin: 0 auto;
		padding: calc(3rem + var(--nav-offset, 0px)) 2rem 4rem;
		width: 100%;
		box-sizing: border-box;
		overflow-x: hidden;
	}

	footer {
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.98), rgba(44, 70, 114, 0.9));
		color: var(--white);
		padding: 3rem 0 0;
		margin-top: 2rem;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1.6fr;
		gap: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	/* Brand column */
	.footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--white);
		text-decoration: none;
		margin-bottom: 1rem;
	}

	.footer-logo-gmhs {
		height: 34px;
		width: auto;
		object-fit: contain;
		display: block;
	}

	.footer-logo-divider {
		width: 1px;
		height: 26px;
		background: rgba(255, 255, 255, 0.3);
	}

	.footer-logo-diamond {
		height: 30px;
		width: auto;
		object-fit: contain;
		display: block;
	}

	.footer-logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.footer-logo-school {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}

	.footer-logo-event {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--white);
	}

	.footer-description {
		font-size: 0.88rem;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.7);
		margin: 0.75rem 0 1.25rem;
	}

	.footer-social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.footer-social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 500;
		padding: 0.45rem 0.9rem 0.45rem 0.7rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}

	.footer-social-link:hover {
		color: var(--white);
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.4);
	}

	.footer-social-link svg {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	/* Navigation column */
	.footer-heading {
		font-family: 'Merriweather', 'Times New Roman', serif;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--brand-sky);
		margin: 0 0 1rem;
	}

	.footer-nav ul {
		list-style: none;
		display: grid;
		gap: 0.6rem;
	}

	.footer-nav a {
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: color 0.2s ease, padding-left 0.2s ease;
		display: inline-block;
	}

	.footer-nav a:hover {
		color: var(--white);
		padding-left: 4px;
	}

	/* Newsletter column */
	.footer-newsletter-desc {
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.7);
		margin: 0 0 1rem;
	}

	.newsletter-form {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.newsletter-input-row {
		display: flex;
		gap: 0;
		border-radius: 10px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.22);
		transition: border-color 0.2s ease;
	}

	.newsletter-input-row:focus-within {
		border-color: var(--brand-sky);
	}

	.newsletter-input-row input[type="email"] {
		flex: 1;
		padding: 0.65rem 1rem;
		background: rgba(255, 255, 255, 0.08);
		border: none;
		color: var(--white);
		font-family: 'Montserrat', sans-serif;
		font-size: 0.88rem;
		outline: none;
		min-width: 0;
	}

	.newsletter-input-row input[type="email"]::placeholder {
		color: rgba(255, 255, 255, 0.45);
	}

	.newsletter-input-row button[type="submit"] {
		padding: 0.65rem 1.1rem;
		background: var(--brand-sky);
		color: var(--white);
		font-family: 'Montserrat', sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		border: none;
		cursor: pointer;
		white-space: nowrap;
		transition: background 0.2s ease;
		flex-shrink: 0;
	}

	.newsletter-input-row button[type="submit"]:hover {
		background: #4d96d8;
	}

	.newsletter-input-row button[type="submit"]:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.newsletter-status {
		font-size: 0.83rem;
		min-height: 1.2em;
		margin: 0;
	}

	.newsletter-status--success {
		color: #86efac;
	}

	.newsletter-status--error {
		color: #fca5a5;
	}

	/* Screen-reader only helper */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
