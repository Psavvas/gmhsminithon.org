---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import NavBehavior from "../components/NavBehavior.astro";
import clubInfo from "../data/clubInfo.json";

export interface Props {
  title: string;
  description?: string;
}

const defaultDescription =
  "Great Mills High School Mini-THON is a student-led effort raising funds and awareness for Four Diamonds to fight pediatric cancer through school events, community partnerships, and year-round fundraising.";
const diamondFaviconHref =
  "https://wzec6kbgu0.ufs.sh/f/f6kAnf2T9Q2ZZoJE4qULqN4ePIY1XT27BczblO8y6VKuQtEf";

const { title, description = defaultDescription } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="og:title" content={title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Merriweather:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={diamondFaviconHref} />
    <link rel="shortcut icon" href={diamondFaviconHref} />
    <link rel="apple-touch-icon" href={diamondFaviconHref} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-container">
        <a href="/" class="logo">
          <img
            class="logo-gmhs"
            src="https://wzec6kbgu0.ufs.sh/f/f6kAnf2T9Q2ZJMvUcyKDkXFACBzYx7mrThJWZb6eUpl1wcH4"
            alt="Great Mills High School"
            loading="eager"
          />
          <span class="logo-divider" aria-hidden="true"></span>
          <img
            class="logo-diamond"
            src="https://wzec6kbgu0.ufs.sh/f/f6kAnf2T9Q2ZZoJE4qULqN4ePIY1XT27BczblO8y6VKuQtEf"
            alt="Mini-THON diamond"
            loading="eager"
          />
          <span class="logo-text">
            <span class="logo-text-school">GMHS</span>
            <span class="logo-text-event">Mini-THON</span>
          </span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-controls="primary-nav"
          aria-expanded="false"
        >
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <ul class="nav-links" id="primary-nav">
          <li>
            <a href="/" class={currentPath === "/" ? "active" : ""}>Home</a>
          </li>
          <li>
            <a href="/about" class={currentPath === "/about" ? "active" : ""}
              >About</a
            >
          </li>
          <li>
            <a
              href="/sponsors"
              class={currentPath === "/sponsors" ? "active" : ""}>Sponsors</a
            >
          </li>
          <li>
            <a
              href="/get-involved"
              class={currentPath === "/get-involved" ? "active" : ""}
              >Get Involved</a
            >
          </li>
          <li>
            <a href="/events" class={currentPath === "/events" ? "active" : ""}
              >Events</a
            >
          </li>
          <li>
            <a
              href="/fundraising"
              class={currentPath === "/fundraising" ? "active" : ""}
              >Fundraising</a
            >
          </li>
          <li>
            <a href="/members/login" class="member-login">Member Login</a>
          </li>
        </ul>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-container">
        <div class="footer-grid">
          <!-- Brand column -->
          <div class="footer-brand">
            <a href="/" class="footer-logo">
              <img
                src="https://wzec6kbgu0.ufs.sh/f/f6kAnf2T9Q2ZJMvUcyKDkXFACBzYx7mrThJWZb6eUpl1wcH4"
                alt="Great Mills High School"
                class="footer-logo-gmhs"
                loading="lazy"
              />
              <span class="footer-logo-divider" aria-hidden="true"></span>
              <img
                src="https://wzec6kbgu0.ufs.sh/f/f6kAnf2T9Q2ZZoJE4qULqN4ePIY1XT27BczblO8y6VKuQtEf"
                alt="Mini-THON diamond"
                class="footer-logo-diamond"
                loading="lazy"
              />
              <span class="footer-logo-text">
                <span class="footer-logo-school">GMHS</span>
                <span class="footer-logo-event">Mini-THON</span>
              </span>
            </a>
            <p class="footer-description">
              A student-driven charitable organization at Great Mills High
              School dedicated to raising funds and awareness for pediatric
              cancer through Four Diamonds.
            </p>
            <div class="footer-social">
              <a
                href={clubInfo.socialMedia.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-social-link"
                aria-label="Follow us on Instagram"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle
                    cx="17.5"
                    cy="6.5"
                    r="1.5"
                    fill="currentColor"
                    stroke="none"></circle>
                </svg>
                <span>Instagram</span>
              </a>
              <a
                href={clubInfo.socialMedia.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-social-link"
                aria-label="Follow us on Facebook"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                  width="24"
                  height="24"
                >
                  <path
                    d="M22.675 0h-21.35C.595 0 0 .592 0 1.326v21.348C0 23.408.595 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.797.143v3.24l-1.918.001c-1.504 0-1.797.715-1.797 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.406 24 24 23.408 24 22.674V1.326C24 .592 23.406 0 22.675 0"
                  ></path>
                </svg>
                <span>Facebook</span>
              </a>
              <a
                href={clubInfo.socialMedia.tiktok}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-social-link"
                aria-label="Follow us on TikTok"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                  width="24"
                  height="24"
                >
                  <path
                    d="M12.525.02c1.31-.02 2.61-.01 3.91 0 .08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.67 1.69 4.2 1.77v4.03c-1.43-.04-2.86-.35-4.18-.89-.57-.24-1.1-.53-1.62-.85-.01 2.92.02 5.84-.02 8.75-.08 1.4-.54 2.78-1.35 3.92-1.31 1.92-3.58 3.17-5.91 3.29-1.43.08-2.86-.15-4.17-.72-2.12-.92-3.74-2.8-4.47-5-.25-.72-.38-1.48-.43-2.24v-.97c.02-.17.05-.34.07-.51.18-1.21.66-2.37 1.37-3.35 1.01-1.41 2.48-2.48 4.13-3.02 1.07-.35 2.22-.43 3.34-.31.02 1.48-.04 2.96-.04 4.44-.75-.24-1.56-.3-2.33-.14-.53.12-1.03.37-1.44.73a3.16 3.16 0 0 0-1 1.63c-.09.39-.12.79-.08 1.19.17 1.6 1.5 3.05 3.1 3.27 1.06.16 2.14-.09 3-.73.86-.62 1.45-1.62 1.62-2.68.11-.66.07-1.32.08-1.98.01-3.2-.01-6.4.02-9.6z"
                  ></path>
                </svg>
                <span>TikTok</span>
              </a>
              <a
                href="https://fourdiamonds.donordrive.com/GMHSMT"
                target="_blank"
                rel="noopener noreferrer"
                class="footer-social-link"
                aria-label="Donate on DonorDrive"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                  ></path>
                </svg>
                <span>Donate</span>
              </a>
            </div>
          </div>

          <!-- Navigation column -->
          <div class="footer-nav">
            <h3 class="footer-heading">Quick Links</h3>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/sponsors">Sponsors</a></li>
              <li><a href="/get-involved">Get Involved</a></li>
              <li><a href="/events">Events</a></li>
              <li><a href="/fundraising">Fundraising</a></li>
              <li><a href="/members/login">Member Page</a></li>
              <li><a href="/privacy-policy">Privacy Policy</a></li>
            </ul>
          </div>

          <!-- Newsletter column -->
          <div class="footer-newsletter">
            <h3 class="footer-heading">Stay Updated</h3>
            <p class="footer-newsletter-desc">
              Subscribe to our newsletter and never miss an event or update.
            </p>
            <div class="newsletter-coming-soon-wrap">
              <form class="newsletter-form" id="newsletter-form" novalidate>
                <div class="newsletter-input-row">
                  <label for="newsletter-email" class="sr-only"
                    >Email address</label
                  >
                  <input
                    type="email"
                    id="newsletter-email"
                    name="email"
                    placeholder="Your email address"
                    required
                    autocomplete="email"
                    disabled
                  />
                  <button type="submit" disabled>Subscribe</button>
                </div>
                <p
                  class="newsletter-status"
                  id="newsletter-status"
                  aria-live="polite"
                >
                </p>
              </form>
              <div class="newsletter-coming-soon-overlay" aria-hidden="true">
                <span class="newsletter-coming-soon-badge">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  Newsletter coming soon
                </span>
              </div>
            </div>
            <h3 class="footer-heading">Contact Us</h3>
            <p class="footer-newsletter-desc">
              Send us an email at: <a
                href="mailto:hello@gmhsminithon.org"
                style="color:rgba(255,255,255,0.7);text-decoration:underline;font-weight:500;"
                >hello@gmhsminithon.org</a
              >
            </p>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-copyright">
            &copy; {new Date().getFullYear()} Great Mills High School Mini-THON.
          </p>
          <p class="footer-legal">
            Mini-THON® and Four Diamonds Mini-THON® are registered trademarks.
            The Diamond Masthead and DonorDrive® are owned by their respective
            trademark holders. Used with permission.
          </p>
          <p class="footer-privacy-link">
            <a href="/privacy-policy">Privacy Policy</a>
          </p>
        </div>
      </div>
    </footer>

    <script>
      const form = document.getElementById(
        "newsletter-form",
      ) as HTMLFormElement | null;
      const statusEl = document.getElementById("newsletter-status");

      if (form && statusEl) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const button = form.querySelector(
            'button[type="submit"]',
          ) as HTMLButtonElement | null;
          if (button) button.disabled = true;
          statusEl.textContent = "";
          statusEl.className = "newsletter-status";

          try {
            const formData = new FormData(form);
            const res = await fetch("/api/newsletter", {
              method: "POST",
              body: formData,
            });
            const json = (await res.json()) as {
              success?: boolean;
              error?: string;
            };

            if (json.success) {
              statusEl.textContent = "✓ You're subscribed! Thank you.";
              statusEl.classList.add("newsletter-status--success");
              form.reset();
            } else {
              statusEl.textContent =
                json.error ?? "Something went wrong. Please try again.";
              statusEl.classList.add("newsletter-status--error");
            }
          } catch {
            statusEl.textContent =
              "Unable to subscribe right now. Please try again later.";
            statusEl.classList.add("newsletter-status--error");
          } finally {
            if (button) button.disabled = false;
          }
        });
      }
    </script>
    <NavBehavior />
    <SpeedInsights />
  </body>
</html>

<style>
  :root {
    --brand-ink: #2c4672;
    --brand-sky: #6aaae4;
    --ink-900: #1c2a3a;
    --ink-700: #3d4c5c;
    --ink-500: #6a7a8a;
    --surface: #f4f7fb;
    --surface-raised: #ffffff;
    --border-soft: #d7e2ef;
    --white: #ffffff;
    --shadow-soft: 0 18px 45px rgba(28, 42, 58, 0.12);
    --shadow-card: 0 12px 30px rgba(28, 42, 58, 0.08);
    --nav-overlay: linear-gradient(
      135deg,
      rgba(44, 70, 114, 0.98),
      rgba(106, 170, 228, 0.95)
    );
    --nav-offset: 84px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: "Montserrat", "Helvetica Neue", "Noto Sans", sans-serif;
    background-color: var(--surface);
    color: var(--ink-900);
    overflow-x: hidden;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    position: relative;
    background:
      radial-gradient(
        circle at 10% 10%,
        rgba(106, 170, 228, 0.18),
        transparent 45%
      ),
      linear-gradient(140deg, rgba(44, 70, 114, 0.05), transparent 35%),
      var(--surface);
    overflow-x: hidden;
    padding-top: 0;
  }

  body.nav-hidden {
    padding-top: 0;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgba(44, 70, 114, 0.08),
      rgba(106, 170, 228, 0.06)
    );
    pointer-events: none;
    z-index: 0;
  }

  main,
  .navbar,
  footer {
    position: relative;
    z-index: 1;
  }

  :global(h1),
  :global(h2),
  :global(h3) {
    font-family: "Merriweather", "Times New Roman", serif;
    letter-spacing: 0.01em;
    color: var(--ink-900);
  }

  @keyframes nav-enter {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .navbar {
    background: linear-gradient(
      120deg,
      rgba(44, 70, 114, 0.98),
      rgba(44, 70, 114, 0.92)
    );
    color: var(--white);
    padding: 1rem 0;
    box-shadow: 0 4px 20px rgba(28, 42, 58, 0.15);
    backdrop-filter: blur(14px);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
    animation: nav-enter 0.3s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar {
      animation: none;
    }
  }

  .navbar.is-hidden {
    transform: translateY(-100%);
    box-shadow: none;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--white);
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-gmhs {
    height: 34px;
    width: auto;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .logo-divider {
    width: 1px;
    height: 26px;
    background: rgba(255, 255, 255, 0.3);
    flex-shrink: 0;
  }

  .logo-diamond {
    height: 30px;
    width: auto;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-text-school {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .logo-text-event {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--white);
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 1.25rem;
    align-items: center;
  }

  .nav-links a {
    color: var(--white);
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--brand-sky);
    border-bottom-color: var(--brand-sky);
  }

  .member-login {
    background: var(--brand-sky);
    padding: 0.45rem 1.1rem !important;
    border-radius: 999px;
    font-weight: 600;
    letter-spacing: 0.02em;
    border-bottom: 2px solid transparent !important;
    transition: all 0.3s ease;
  }

  .member-login:hover {
    background-color: var(--white);
    color: var(--brand-ink) !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(106, 170, 228, 0.3);
  }

  main {
    flex: 1;
    max-width: 1160px;
    margin: 0 auto;
    padding: calc(3rem + var(--nav-offset, 0px)) 2rem 4rem;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  footer {
    background: linear-gradient(
      120deg,
      rgba(44, 70, 114, 0.98),
      rgba(44, 70, 114, 0.9)
    );
    color: var(--white);
    padding: 3rem 0 0;
    margin-top: 2rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.6fr;
    gap: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Brand column */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--white);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .footer-logo-gmhs {
    height: 34px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .footer-logo-divider {
    width: 1px;
    height: 26px;
    background: rgba(255, 255, 255, 0.3);
  }

  .footer-logo-diamond {
    height: 30px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .footer-logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .footer-logo-school {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .footer-logo-event {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--white);
  }

  .footer-description {
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.7);
    margin: 0.75rem 0 1.25rem;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.45rem 0.9rem 0.45rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .footer-social-link:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .footer-social-link svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Navigation column */
  .footer-heading {
    font-family: "Merriweather", "Times New Roman", serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--brand-sky);
    margin: 0 0 1rem;
  }

  .footer-nav ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .footer-nav a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition:
      color 0.2s ease,
      padding-left 0.2s ease;
    display: inline-block;
  }

  .footer-nav a:hover {
    color: var(--white);
    padding-left: 4px;
  }

  /* Newsletter column */
