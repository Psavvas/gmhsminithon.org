---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import NavBehavior from '../components/NavBehavior.astro';
import clubInfo from '../data/clubInfo.json';

export interface Props {
	title: string;
	description?: string;
}

const { title, description = "Mini-THON - Fighting Pediatric Cancer" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Merriweather:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/masthead-diamond-blue.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<Analytics />
	</head>
	<body>
		<nav class="navbar">
			<div class="nav-container">
				<a href="/" class="logo">
					<img class="logo-gmhs" src="/gmhs-logo.png" alt="Great Mills High School" loading="eager" />
					<span class="logo-divider" aria-hidden="true"></span>
					<img class="logo-diamond" src="/masthead-diamond-white.svg" alt="Mini-THON diamond" loading="eager" />
					<span class="logo-text">
						<span class="logo-text-school">GMHS</span>
						<span class="logo-text-event">Mini-THON</span>
					</span>
				</a>
				<button class="nav-toggle" type="button" aria-controls="primary-nav" aria-expanded="false">
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>
				<ul class="nav-links" id="primary-nav">
					<li><a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a></li>
					<li><a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a></li>
					<li><a href="/sponsors" class={currentPath === '/sponsors' ? 'active' : ''}>Sponsors</a></li>
					<li><a href="/get-involved" class={currentPath === '/get-involved' ? 'active' : ''}>Get Involved</a></li>
					<li><a href="/events" class={currentPath === '/events' ? 'active' : ''}>Events</a></li>
					<li><a href="/fundraising" class={currentPath === '/fundraising' ? 'active' : ''}>Fundraising</a></li>
					<li><a href="/members/login" class="member-login">Member Login</a></li>
				</ul>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-container">
				<div class="footer-grid">
					<!-- Brand column -->
					<div class="footer-brand">
						<a href="/" class="footer-logo">
							<img src="/gmhs-logo.png" alt="Great Mills High School" class="footer-logo-gmhs" loading="lazy" />
							<span class="footer-logo-divider" aria-hidden="true"></span>
							<img src="/masthead-diamond-white.svg" alt="Mini-THON diamond" class="footer-logo-diamond" loading="lazy" />
							<span class="footer-logo-text">
								<span class="footer-logo-school">GMHS</span>
								<span class="footer-logo-event">Mini-THON</span>
							</span>
						</a>
						<p class="footer-description">
							A student-driven charitable organization at Great Mills High School dedicated to raising funds and awareness for pediatric cancer through Four Diamonds.
						</p>
						<div class="footer-social">
							<a href={clubInfo.socialMedia.instagram} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Follow us on Instagram">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
									<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
									<circle cx="12" cy="12" r="4"/>
									<circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
								</svg>
								<span>Instagram</span>
							</a>
							<a href={clubInfo.socialMedia.facebook} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Follow us on Facebook">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" width="24" height="24">
									<path d="M22.675 0h-21.35C.595 0 0 .592 0 1.326v21.348C0 23.408.595 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.797.143v3.24l-1.918.001c-1.504 0-1.797.715-1.797 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.406 24 24 23.408 24 22.674V1.326C24 .592 23.406 0 22.675 0"/>
								</svg>
								<span>Facebook</span>
							</a>
							<a href={clubInfo.socialMedia.tiktok} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Follow us on TikTok">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" width="24" height="24">
									<path d="M12.5 2c.3 4.2 3.1 6.2 6.5 6.4v3.1c-1.1-.1-2.2-.3-3.2-.7v7.2c0 3.1-2.1 4.8-4.7 4.8-2.7 0-4.6-1.7-4.6-4.5 0-2.7 2-4.5 4.6-4.5.3 0 .6 0 .9.1v2.7c-.2-.1-.5-.1-.8-.1-1.2 0-2.1.8-2.1 2.1 0 1.2.8 2.1 2.1 2.1 1.2 0 2.1-.8 2.1-2.1V2h1.2z"/>
								</svg>
								<span>TikTok</span>
							</a>
							<a href="https://fourdiamonds.donordrive.com/GMHSMT" target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="Donate on DonorDrive">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
									<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
								</svg>
								<span>Donate</span>
							</a>
						</div>
					</div>

					<!-- Navigation column -->
					<div class="footer-nav">
						<h3 class="footer-heading">Quick Links</h3>
						<ul>
							<li><a href="/">Home</a></li>
							<li><a href="/about">About</a></li>
							<li><a href="/sponsors">Sponsors</a></li>
							<li><a href="/get-involved">Get Involved</a></li>
							<li><a href="/events">Events</a></li>
							<li><a href="/fundraising">Fundraising</a></li>
							<li><a href="/members/login">Member Page</a></li>
						</ul>
					</div>

					<!-- Newsletter column -->
					<div class="footer-newsletter">
						<h3 class="footer-heading">Stay Updated</h3>
						<p class="footer-newsletter-desc">Subscribe to our newsletter and never miss an event or update.</p>
						<div class="newsletter-coming-soon-wrapper" aria-describedby="newsletter-coming-soon-msg">
							<div id="newsletter-coming-soon-msg" class="newsletter-coming-soon-overlay" role="status" aria-label="Newsletter coming soon">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="20" height="20">
									<circle cx="12" cy="12" r="10"/>
									<line x1="12" y1="8" x2="12" y2="12"/>
									<line x1="12" y1="16" x2="12.01" y2="16"/>
								</svg>
								<span>Newsletter Coming Soon</span>
							</div>
							<form class="newsletter-form" id="newsletter-form" novalidate aria-hidden="true" aria-describedby="newsletter-coming-soon-msg">
								<div class="newsletter-input-row">
									<label for="newsletter-email" class="sr-only">Email address</label>
									<input
										type="email"
										id="newsletter-email"
										name="email"
										placeholder="Your email address"
										required
										autocomplete="email"
										disabled
									/>
									<button type="submit" disabled>Subscribe</button>
								</div>
								<p class="newsletter-status" id="newsletter-status" aria-live="polite"></p>
							</form>
						</div>
						<h3 class="footer-heading">Contact Us</h3>
						<p class="footer-newsletter-desc">Send us an email at: <a href="mailto:hello@gmhsminithon.org" style="color:rgba(255,255,255,0.7);text-decoration:underline;font-weight:500;">hello@gmhsminithon.org</a></p>
					</div>
				</div>

				<div class="footer-bottom">
					<p class="footer-copyright">&copy; {new Date().getFullYear()} Great Mills High School Mini-THON.</p>
					<p class="footer-legal">Mini-THON® and Four Diamonds Mini-THON® are registered trademarks. The Diamond Masthead and DonorDrive® are owned by their respective trademark holders. Used with permission.</p>
				</div>
			</div>
		</footer>

		<!-- Social Profiles Modal -->
		<div id="social-modal" class="social-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="social-modal-title" hidden>
			<div class="social-modal-panel">
				<button class="social-modal-close" aria-label="Close social profiles" id="social-modal-close">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18"/>
						<line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
				<div class="social-modal-header">
					<img src="/masthead-diamond-blue.svg" alt="" class="social-modal-diamond" aria-hidden="true" width="36" height="36" loading="lazy" />
					<h2 id="social-modal-title">Connect With Us</h2>
					<p class="social-modal-subtitle">Follow GMHS Mini-THON on social media to stay updated on events, highlights, and more.</p>
				</div>
				<div class="social-modal-links">
					<a href={clubInfo.socialMedia.instagram} target="_blank" rel="noopener noreferrer" class="social-modal-link instagram">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="22" height="22">
							<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
							<circle cx="12" cy="12" r="4"/>
							<circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
						</svg>
						<div class="social-modal-link-text">
							<span class="social-modal-link-name">Instagram</span>
							<span class="social-modal-link-handle">@gmhsminithon</span>
						</div>
						<svg class="social-modal-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
					<a href={clubInfo.socialMedia.facebook} target="_blank" rel="noopener noreferrer" class="social-modal-link facebook">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="22" height="22">
							<path d="M22.675 0h-21.35C.595 0 0 .592 0 1.326v21.348C0 23.408.595 24 1.325 24h11.495v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.797.143v3.24l-1.918.001c-1.504 0-1.797.715-1.797 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.406 24 24 23.408 24 22.674V1.326C24 .592 23.406 0 22.675 0"/>
						</svg>
						<div class="social-modal-link-text">
							<span class="social-modal-link-name">Facebook</span>
							<span class="social-modal-link-handle">GMHS Mini-THON</span>
						</div>
						<svg class="social-modal-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
					<a href={clubInfo.socialMedia.tiktok} target="_blank" rel="noopener noreferrer" class="social-modal-link tiktok">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="22" height="22">
							<path d="M12.5 2c.3 4.2 3.1 6.2 6.5 6.4v3.1c-1.1-.1-2.2-.3-3.2-.7v7.2c0 3.1-2.1 4.8-4.7 4.8-2.7 0-4.6-1.7-4.6-4.5 0-2.7 2-4.5 4.6-4.5.3 0 .6 0 .9.1v2.7c-.2-.1-.5-.1-.8-.1-1.2 0-2.1.8-2.1 2.1 0 1.2.8 2.1 2.1 2.1 1.2 0 2.1-.8 2.1-2.1V2h1.2z"/>
						</svg>
						<div class="social-modal-link-text">
							<span class="social-modal-link-name">TikTok</span>
							<span class="social-modal-link-handle">@gmhs.minithon</span>
						</div>
						<svg class="social-modal-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="16" height="16">
							<path d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</a>
				</div>
				<div class="social-modal-newsletter">
					<div class="social-modal-newsletter-badge">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
							<polyline points="22,6 12,13 2,6"/>
						</svg>
						<span>Newsletter — Coming Soon</span>
					</div>
					<p class="social-modal-newsletter-text">We're working on a newsletter to keep you in the loop. Check back soon!</p>
				</div>
			</div>
		</div>

		<script>
			// Social Modal
			const socialModal = document.getElementById('social-modal');
			const socialModalClose = document.getElementById('social-modal-close');

			function openSocialModal() {
				if (!socialModal) return;
				socialModal.hidden = false;
				document.body.style.overflow = 'hidden';
				socialModalClose?.focus();
			}

			function closeSocialModal() {
				if (!socialModal) return;
				socialModal.hidden = true;
				document.body.style.overflow = '';
			}

			// Open modal from any element with data-open-social-modal attribute
			document.addEventListener('click', (e) => {
				const target = e.target as Element;
				if (target?.closest('[data-open-social-modal]')) {
					e.preventDefault();
					openSocialModal();
				}
			});

			socialModalClose?.addEventListener('click', closeSocialModal);

			socialModal?.addEventListener('click', (e) => {
				if (e.target === socialModal) closeSocialModal();
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && socialModal && !socialModal.hidden) {
					closeSocialModal();
				}
			});
		</script>
		<NavBehavior />
		<SpeedInsights />
	</body>
</html>

<style>
	:root {
		--brand-ink: #2C4672;
		--brand-sky: #6AAAE4;
		--ink-900: #1C2A3A;
		--ink-700: #3D4C5C;
		--ink-500: #6A7A8A;
		--surface: #F4F7FB;
		--surface-raised: #FFFFFF;
		--border-soft: #D7E2EF;
		--white: #FFFFFF;
		--shadow-soft: 0 18px 45px rgba(28, 42, 58, 0.12);
		--shadow-card: 0 12px 30px rgba(28, 42, 58, 0.08);
		--nav-overlay: linear-gradient(135deg, rgba(44, 70, 114, 0.98), rgba(106, 170, 228, 0.95));
		--nav-offset: 84px;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: 'Montserrat', 'Helvetica Neue', 'Noto Sans', sans-serif;
		background-color: var(--surface);
		color: var(--ink-900);
		overflow-x: hidden;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		position: relative;
		background: radial-gradient(circle at 10% 10%, rgba(106, 170, 228, 0.18), transparent 45%),
			linear-gradient(140deg, rgba(44, 70, 114, 0.05), transparent 35%),
			var(--surface);
		overflow-x: hidden;
		padding-top: 0;
	}

	body.nav-hidden {
		padding-top: 0;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.08), rgba(106, 170, 228, 0.06));
		pointer-events: none;
		z-index: 0;
	}

	main,
	.navbar,
	footer {
		position: relative;
		z-index: 1;
	}

	:global(h1),
	:global(h2),
	:global(h3) {
		font-family: 'Merriweather', 'Times New Roman', serif;
		letter-spacing: 0.01em;
		color: var(--ink-900);
	}

	@keyframes nav-enter {
		from {
			transform: translateY(-100%);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	.navbar {
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.98), rgba(44, 70, 114, 0.92));
		color: var(--white);
		padding: 1rem 0;
		box-shadow: 0 4px 20px rgba(28, 42, 58, 0.15);
		backdrop-filter: blur(14px);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
		animation: nav-enter 0.3s ease-out both;
	}

	@media (prefers-reduced-motion: reduce) {
		.navbar {
			animation: none;
		}
	}

	.navbar.is-hidden {
		transform: translateY(-100%);
		box-shadow: none;
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--white);
		text-decoration: none;
		flex-shrink: 0;
	}

	.logo-gmhs {
		height: 34px;
		width: auto;
		object-fit: contain;
		display: block;
		flex-shrink: 0;
	}

	.logo-divider {
		width: 1px;
		height: 26px;
		background: rgba(255, 255, 255, 0.3);
		flex-shrink: 0;
	}

	.logo-diamond {
		height: 30px;
		width: auto;
		object-fit: contain;
		display: block;
		flex-shrink: 0;
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.logo-text-school {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}

	.logo-text-event {
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--white);
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 1.25rem;
		align-items: center;
	}

	.nav-links a {
		color: var(--white);
		text-decoration: none;
		transition: all 0.3s ease;
		padding: 0.5rem 0;
		border-bottom: 2px solid transparent;
		font-weight: 500;
		font-size: 0.95rem;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--brand-sky);
		border-bottom-color: var(--brand-sky);
	}

	.member-login {
		background: var(--brand-sky);
		padding: 0.45rem 1.1rem !important;
		border-radius: 999px;
		font-weight: 600;
		letter-spacing: 0.02em;
		border-bottom: 2px solid transparent !important;
		transition: all 0.3s ease;
	}

	.member-login:hover {
		background-color: var(--white);
		color: var(--brand-ink) !important;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(106, 170, 228, 0.3);
	}

	main {
		flex: 1;
		max-width: 1160px;
		margin: 0 auto;
		padding: calc(3rem + var(--nav-offset, 0px)) 2rem 4rem;
		width: 100%;
		box-sizing: border-box;
		overflow-x: hidden;
	}

	footer {
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.98), rgba(44, 70, 114, 0.9));
		color: var(--white);
		padding: 3rem 0 0;
		margin-top: 2rem;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1.6fr;
		gap: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
	}

	/* Brand column */
	.footer-logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--white);
		text-decoration: none;
