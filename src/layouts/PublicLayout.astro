---
export interface Props {
	title: string;
	description?: string;
}

const { title, description = "Mini-THON - Fighting Pediatric Cancer" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<nav class="navbar">
			<div class="nav-container">
				<a href="/" class="logo">
					<span class="logo-mark" aria-hidden="true">
						<img class="logo-gmhs" src="/gmhs-logo.png" alt="" loading="eager" />
						<span class="logo-x">+</span>
						<img class="logo-diamond" src="/masthead-diamond-white.svg" alt="" loading="eager" />
					</span>
					<span class="logo-text">GMHS Mini-THON</span>
				</a>
				<button class="nav-toggle" type="button" aria-controls="primary-nav" aria-expanded="false">
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>
				<ul class="nav-links" id="primary-nav">
					<li><a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a></li>
					<li><a href="/about" class={currentPath === '/about' ? 'active' : ''}>About</a></li>
					<li><a href="/sponsors" class={currentPath === '/sponsors' ? 'active' : ''}>Sponsors</a></li>
					<li><a href="/get-involved" class={currentPath === '/get-involved' ? 'active' : ''}>Get Involved</a></li>
					<li><a href="/events" class={currentPath === '/events' ? 'active' : ''}>Events</a></li>
					<li><a href="/fundraising" class={currentPath === '/fundraising' ? 'active' : ''}>Fundraising</a></li>
					<li><a href="/members/login" class="member-login">Member Login</a></li>
				</ul>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-container">
				<p>&copy; {new Date().getFullYear()} Mini-THON. All rights reserved.</p>
				<p>Supporting Four Diamonds and Penn State Hershey Children's Hospital</p>
			</div>
		</footer>
		<script>
			const navbar = document.querySelector('.navbar');
			const toggle = document.querySelector('.nav-toggle');
			const navLinks = document.querySelector('.nav-links');

			if (navbar && toggle && navLinks) {
				toggle.addEventListener('click', () => {
					const isOpen = navbar.classList.toggle('nav-open');
					toggle.setAttribute('aria-expanded', String(isOpen));
				});

				navLinks.querySelectorAll('a').forEach((link) => {
					link.addEventListener('click', () => {
						navbar.classList.remove('nav-open');
						toggle.setAttribute('aria-expanded', 'false');
					});
				});
			}
		</script>
	</body>
</html>

<style>
	:root {
		--brand-ink: #2C4672;
		--brand-sky: #6AAAE4;
		--ink-900: #1C2A3A;
		--ink-700: #3D4C5C;
		--ink-500: #6A7A8A;
		--surface: #F4F7FB;
		--surface-raised: #FFFFFF;
		--border-soft: #D7E2EF;
		--white: #FFFFFF;
		--shadow-soft: 0 18px 45px rgba(28, 42, 58, 0.12);
		--shadow-card: 0 12px 30px rgba(28, 42, 58, 0.08);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: 'Source Sans 3', 'Helvetica Neue', 'Noto Sans', sans-serif;
		background-color: var(--surface);
		color: var(--ink-900);
		overflow-x: hidden;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		position: relative;
		background: radial-gradient(circle at 10% 10%, rgba(106, 170, 228, 0.18), transparent 45%),
			linear-gradient(140deg, rgba(44, 70, 114, 0.05), transparent 35%),
			var(--surface);
		overflow-x: hidden;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.08), rgba(106, 170, 228, 0.06));
		pointer-events: none;
		z-index: 0;
	}

	main,
	.navbar,
	footer {
		position: relative;
		z-index: 1;
	}

	:global(h1),
	:global(h2),
	:global(h3) {
		font-family: 'Playfair Display', 'Times New Roman', serif;
		letter-spacing: 0.01em;
		color: var(--ink-900);
	}

	.navbar {
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.98), rgba(44, 70, 114, 0.92));
		color: var(--white);
		padding: 1rem 0;
		box-shadow: 0 4px 20px rgba(28, 42, 58, 0.15);
		backdrop-filter: blur(14px);
		position: sticky;
		top: 0;
		z-index: 1000;
		transition: all 0.3s ease;
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 1.4rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--white);
		text-decoration: none;
	}

	.logo-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 110px;
		height: 40px;
		border-radius: 999px;
		padding: 3px 6px;
		background: rgba(255, 255, 255, 0.08);
		box-shadow: 0 6px 14px rgba(0, 0, 0, 0.2);
	}

	.logo-gmhs,
	.logo-diamond {
		height: 100%;
		max-width: 44px;
		width: auto;
		object-fit: contain;
		display: block;
		flex: 0 0 auto;
	}

	.logo-x {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--white);
	}

	.logo-text {
		display: inline-block;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 2rem;
		align-items: center;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		background: rgba(255, 255, 255, 0.1);
		align-items: center;
		justify-content: center;
		gap: 4px;
		padding: 0;
		cursor: pointer;
		transition: background 0.2s ease;
		position: relative;
		z-index: 1002;
	}

	.nav-toggle:hover {
		background: rgba(255, 255, 255, 0.15);
	}

	.nav-toggle-bar {
		display: block;
		width: 20px;
		height: 2px;
		background: var(--white);
		border-radius: 999px;
		transition: transform 0.3s ease, opacity 0.2s ease;
	}

	.nav-links a {
		color: var(--white);
		text-decoration: none;
		transition: all 0.3s ease;
		padding: 0.5rem 0;
		border-bottom: 2px solid transparent;
		font-weight: 500;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--brand-sky);
		border-bottom-color: var(--brand-sky);
	}

	.member-login {
		background: var(--brand-sky);
		padding: 0.5rem 1.5rem !important;
		border-radius: 999px;
		font-weight: 600;
		letter-spacing: 0.02em;
		border-bottom: 2px solid transparent !important;
		transition: all 0.3s ease;
	}

	.member-login:hover {
		background-color: var(--white);
		color: var(--brand-ink) !important;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(106, 170, 228, 0.3);
	}

	main {
		flex: 1;
		max-width: 1160px;
		margin: 0 auto;
		padding: 3rem 2rem 4rem;
		width: 100%;
		box-sizing: border-box;
		overflow-x: hidden;
	}

	footer {
		background: linear-gradient(120deg, rgba(44, 70, 114, 0.98), rgba(44, 70, 114, 0.9));
		color: var(--white);
		padding: 2.5rem 0;
		margin-top: 4rem;
		text-align: center;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	footer p {
		margin: 0.5rem 0;
	}

	@media (max-width: 1024px) {
		.nav-links {
			gap: 1.2rem;
			font-size: 0.9rem;
		}

		.logo {
			font-size: 1.2rem;
		}

		.logo-mark {
			width: 90px;
			height: 36px;
		}
	}

	@media (max-width: 900px) {
		.nav-container {
			flex-direction: row;
			gap: 1rem;
			padding: 0 1.5rem;
		}

		.nav-toggle {
			display: flex;
		}

		main {
			padding: 2rem 1rem 3rem;
		}

		.nav-links {
			position: fixed;
			right: 0;
			top: 0;
			left: 0;
			bottom: 0;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1.5rem;
			padding: 2rem;
			background: linear-gradient(135deg, rgba(44, 70, 114, 0.98), rgba(106, 170, 228, 0.95));
			backdrop-filter: blur(20px);
			display: none;
			opacity: 0;
			z-index: 1001;
			box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
			transition: opacity 0.3s ease;
		}

		.nav-links a {
			font-size: 1.2rem;
			width: auto;
			text-align: center;
			padding: 0.75rem 1.5rem;
			white-space: nowrap;
		}

		.navbar.nav-open .nav-links {
			display: flex;
			opacity: 1;
		}

		.navbar.nav-open .nav-toggle-bar:nth-child(1) {
			transform: translateY(6px) rotate(45deg);
		}

		.navbar.nav-open .nav-toggle-bar:nth-child(2) {
			opacity: 0;
		}

		.navbar.nav-open .nav-toggle-bar:nth-child(3) {
			transform: translateY(-6px) rotate(-45deg);
		}
	}

	@media (max-width: 480px) {
		.logo {
			font-size: 1rem;
			gap: 0.5rem;
		}

		.logo-mark {
			width: 80px;
			height: 32px;
		}

		.logo-text {
			font-size: 0.9rem;
		}

		.nav-container {
			padding: 0 1rem;
		}

		.nav-links a {
			font-size: 1.1rem;
			padding: 0.65rem 1.2rem;
		}
	}
</style>
