---
import Analytics from '@vercel/analytics/astro';
import NavBehavior from '../components/NavBehavior.astro';

export interface Props {
	title: string;
	description?: string;
}

const { title, description = "Mini-THON Member Portal" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Merriweather:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<Analytics />
	</head>
	<body>
		<nav class="navbar">
			<div class="nav-container">
				<a href="/members" class="logo">Mini-THON Members</a>
				<button class="nav-toggle" type="button" aria-controls="member-nav" aria-expanded="false">
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>
				<ul class="nav-links" id="member-nav">
					<li><a href="/members" class={currentPath === '/members' ? 'active' : ''}>Dashboard</a></li>
					<li><a href="/members/volunteer-opportunities" class={currentPath === '/members/volunteer-opportunities' ? 'active' : ''}>Volunteer</a></li>
					<li><a href="/members/meeting-info" class={currentPath === '/members/meeting-info' ? 'active' : ''}>Meeting Info</a></li>
					<li><a href="/" class="return-main">Return to Main Site</a></li>
				</ul>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-container">
				<p>&copy; {new Date().getFullYear()} Mini-THON Member Portal</p>
				<p>Mini-THON® and Four Diamonds' Mini-THON, DonorDrive, and the Diamond logo are owned by Four Diamonds.</p>
			</div>
		</footer>
		<NavBehavior />
	</body>
</html>

<style>
	:root {
		--brand-ink: #2C4672;
		--brand-sky: #6AAAE4;
		--ink-900: #1C2A3A;
		--ink-700: #3D4C5C;
		--ink-500: #6A7A8A;
		--surface: #F1F5FA;
		--surface-raised: #FFFFFF;
		--border-soft: #D7E2EF;
		--white: #FFFFFF;
		--member-accent: #233552;
		--nav-overlay: linear-gradient(135deg, rgba(44, 70, 114, 0.98), rgba(106, 170, 228, 0.95));
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: 'Montserrat', 'Helvetica Neue', 'Noto Sans', sans-serif;
		background-color: var(--surface);
		color: var(--ink-900);
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background: radial-gradient(circle at 12% 10%, rgba(106, 170, 228, 0.16), transparent 45%),
			linear-gradient(140deg, rgba(44, 70, 114, 0.04), transparent 35%),
			var(--surface);
		padding-top: 0;
	}

	body.nav-hidden {
		padding-top: 0;
	}

	:global(h1),
	:global(h2),
	:global(h3) {
		font-family: 'Merriweather', 'Times New Roman', serif;
		letter-spacing: 0.01em;
		color: var(--ink-900);
	}

	.navbar {
		background: linear-gradient(135deg, var(--member-accent) 0%, var(--brand-ink) 100%);
		color: var(--white);
		padding: 1.1rem 0;
		box-shadow: 0 4px 20px rgba(28, 42, 58, 0.15);
		backdrop-filter: blur(14px);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
	}

	.navbar.is-hidden {
		transform: translateY(-100%);
		box-shadow: none;
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--white);
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 1.25rem;
		align-items: center;
	}

	.nav-links a {
		color: var(--white);
		text-decoration: none;
		transition: all 0.3s;
		padding: 0.5rem 0;
		font-size: 0.95rem;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--brand-sky);
	}

	.return-main {
		background-color: var(--brand-sky);
		color: var(--member-accent) !important;
		padding: 0.45rem 1rem !important;
		border-radius: 999px;
		font-weight: 600;
	}

	.return-main:hover {
		background-color: var(--white);
		color: var(--member-accent) !important;
	}

	main {
		flex: 1;
		max-width: 1160px;
		margin: 0 auto;
		padding: calc(3rem + var(--nav-offset, 0px)) 2rem 4rem;
		width: 100%;
	}

	footer {
		background: linear-gradient(135deg, var(--member-accent) 0%, var(--brand-ink) 100%);
		color: var(--white);
		padding: 2rem 0;
		margin-top: 4rem;
		text-align: center;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	@media (max-width: 1120px) {
		.nav-container {
			flex-direction: row;
			gap: 1rem;
			padding: 0 1.5rem;
		}

		.nav-links {
			gap: 1rem;
			font-size: 0.85rem;
		}

		.logo {
			font-size: 1.1rem;
		}
	}
</style>
