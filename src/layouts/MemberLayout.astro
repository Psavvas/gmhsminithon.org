---
export interface Props {
	title: string;
	description?: string;
}

const { title, description = "Mini-THON Member Portal" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Source+Sans+3:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<nav class="navbar">
			<div class="nav-container">
				<a href="/members" class="logo">Mini-THON Members</a>
				<ul class="nav-links">
					<li><a href="/members" class={currentPath === '/members' ? 'active' : ''}>Dashboard</a></li>
					<li><a href="/members/volunteer-opportunities" class={currentPath === '/members/volunteer-opportunities' ? 'active' : ''}>Volunteer</a></li>
					<li><a href="/members/meeting-info" class={currentPath === '/members/meeting-info' ? 'active' : ''}>Meeting Info</a></li>
					<li><a href="/" class="return-main">Return to Main Site</a></li>
				</ul>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-container">
				<p>&copy; {new Date().getFullYear()} Mini-THON Member Portal</p>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--brand-ink: #2C4672;
		--brand-sky: #6AAAE4;
		--ink-900: #1C2A3A;
		--ink-700: #3D4C5C;
		--ink-500: #6A7A8A;
		--surface: #F1F5FA;
		--surface-raised: #FFFFFF;
		--border-soft: #D7E2EF;
		--white: #FFFFFF;
		--member-accent: #233552;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: 'Source Sans 3', 'Helvetica Neue', 'Noto Sans', sans-serif;
		background-color: var(--surface);
		color: var(--ink-900);
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		background: radial-gradient(circle at 12% 10%, rgba(106, 170, 228, 0.16), transparent 45%),
			linear-gradient(140deg, rgba(44, 70, 114, 0.04), transparent 35%),
			var(--surface);
	}

	:global(h1),
	:global(h2),
	:global(h3) {
		font-family: 'Playfair Display', 'Times New Roman', serif;
		letter-spacing: 0.01em;
		color: var(--ink-900);
	}

	.navbar {
		background: linear-gradient(135deg, var(--member-accent) 0%, var(--brand-ink) 100%);
		color: var(--white);
		padding: 1.1rem 0;
		box-shadow: 0 16px 30px rgba(28, 42, 58, 0.2);
	}

	.nav-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--white);
		text-decoration: none;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 2rem;
		align-items: center;
	}

	.nav-links a {
		color: var(--white);
		text-decoration: none;
		transition: all 0.3s;
		padding: 0.5rem 0;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--brand-sky);
	}

	.return-main {
		background-color: var(--brand-sky);
		color: var(--member-accent) !important;
		padding: 0.5rem 1.2rem !important;
		border-radius: 999px;
		font-weight: 600;
	}

	.return-main:hover {
		background-color: var(--white);
		color: var(--member-accent) !important;
	}

	main {
		flex: 1;
		max-width: 1160px;
		margin: 0 auto;
		padding: 3rem 2rem 4rem;
		width: 100%;
	}

	footer {
		background: linear-gradient(135deg, var(--member-accent) 0%, var(--brand-ink) 100%);
		color: var(--white);
		padding: 2rem 0;
		margin-top: 4rem;
		text-align: center;
	}

	.footer-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	@media (max-width: 768px) {
		.nav-links {
			flex-wrap: wrap;
			gap: 1rem;
			font-size: 0.9rem;
		}

		.nav-container {
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
