---
import "../styles/member-portal.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import MemberLogoutButton from "../components/member-auth/MemberLogoutButton";
import {
  MEMBER_AUTH_CALLBACK_PATH,
  MEMBER_LOGIN_PATH,
  getShooBaseUrl,
} from "../utils/auth";
import { isAdminRequest } from "../utils/admin/session";

export interface Props {
  title: string;
  description?: string;
  heading?: string;
  intro?: string;
}

const defaultDescription =
  "Great Mills High School Mini-THON member portal with event details, announcements, resources, and volunteer updates supporting Four Diamonds and the fight against pediatric cancer.";
const diamondFaviconHref =
  "https://wzec6kbgu0.ufs.sh/f/f6kAnf2T9Q2ZZoJE4qULqN4ePIY1XT27BczblO8y6VKuQtEf";

const { title, description = defaultDescription, heading, intro } = Astro.props;
const currentPath = Astro.url.pathname;
// Only admins see the link to the content portal.
const showAdminLink = await isAdminRequest(Astro.request);

const navLinks = [
  { href: "/members", label: "Dashboard", icon: "🏠", exact: true },
  {
    href: "/members/upcoming-events",
    label: "Events",
    icon: "📅",
    match: ["/members/upcoming-events", "/members/events/"],
  },
  { href: "/members/announcements", label: "Announcements", icon: "📣" },
  { href: "/members/club-info", label: "Club Info", icon: "🏫" },
  { href: "/members/resources", label: "Resources", icon: "📚" },
];

function isActive(link: (typeof navLinks)[number]): boolean {
  if (link.exact) {
    return currentPath === link.href;
  }

  const patterns = link.match ?? [link.href];
  return patterns.some((pattern) => currentPath.startsWith(pattern));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:description" content={description} />
    <meta property="og:title" content={title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Merriweather:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={diamondFaviconHref} />
    <link rel="shortcut icon" href={diamondFaviconHref} />
    <link rel="apple-touch-icon" href={diamondFaviconHref} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <header class="mp-topbar">
      <div class="mp-topbar__inner">
        <a class="mp-topbar__brand" href="/members">
          <span class="mp-topbar__mark" aria-hidden="true">MT</span>
          <span>
            <strong>Mini-THON Members</strong>
            <small>Member portal</small>
          </span>
        </a>
        <div class="mp-topbar__actions">
          {
            showAdminLink && (
              <a
                class="mp-button mp-button--ghost mp-button--small"
                href="/admin"
              >
                Admin
              </a>
            )
          }
          <a class="mp-button mp-button--ghost mp-button--small" href="/">
            View site
          </a>
          <MemberLogoutButton
            client:load
            shooBaseUrl={getShooBaseUrl()}
            callbackPath={MEMBER_AUTH_CALLBACK_PATH}
            logoutEndpoint="/api/member-auth/logout"
            loginPath={MEMBER_LOGIN_PATH}
          />
        </div>
      </div>
    </header>

    <div class="mp-shell">
      <nav class="mp-nav" aria-label="Member portal sections">
        {
          navLinks.map((link) => (
            <a
              class={`mp-nav__link${isActive(link) ? " is-active" : ""}`}
              href={link.href}
            >
              <span aria-hidden="true">{link.icon}</span> {link.label}
            </a>
          ))
        }
      </nav>

      <main class="mp-main">
        {
          (heading || intro) && (
            <div class="mp-page-header">
              {heading && <h1>{heading}</h1>}
              {intro && <p class="mp-page-header__intro">{intro}</p>}
            </div>
          )
        }
        <slot />
      </main>
    </div>

    <footer class="mp-footer">
      <div class="mp-footer__inner">
        <p>
          &copy; {new Date().getFullYear()} Great Mills High School Mini-THON.
        </p>
        <p class="mp-footer__legal">
          Mini-THON® and Four Diamonds Mini-THON® are registered trademarks. The
          Diamond Masthead and DonorDrive® are owned by their respective
          trademark holders. Used with permission.
        </p>
      </div>
    </footer>
    <SpeedInsights />
  </body>
</html>
